+#pragma once
+/*! \file
+    \brief Parameters structures for persistent tile schedulers
+*/
+
+#include "cutlass/coord.h"
+#include "cutlass/fast_math.h"
+#include "cutlass/gemm/kernel/tile_scheduler_detail.hpp"
+#include "cutlass/gemm_coord.h"
+#include "cutlass/kernel_hardware_info.h"
+#include "cutlass/platform/platform.h"
+#include "cutlass/workspace.h"
+////////////////////////////////////////////////////////////////////////////////
+
+namespace cutlass {
+namespace gemm {
+namespace kernel {
+namespace detail {
+
+// Parameters for SM90 persistent group scheduler (only used for Grouped Gemms)
+struct PersistentTileSchedulerMoEParams_xe35 {
+  using RasterOrder = cutlass::gemm::kernel::detail::RasterOrder;
+  using RasterOrderOptions = cutlass::gemm::kernel::detail::RasterOrderOptions;
+
+  FastDivmodU64Pow2 divmod_cluster_shape_major_{};
+  FastDivmodU64Pow2 divmod_cluster_shape_minor_{};
+  FastDivmodU64 divmod_cta_shape_m_{};
+  FastDivmodU64 divmod_cta_shape_n_{};
+
+  uint64_t blocks_across_problem_ = 0;
+  bool pre_processed_problem_shapes = false;
+  int32_t log_swizzle_size_ = 0;
+  RasterOrder raster_order_ = RasterOrder::AlongN;
+
+  GemmCoord cta_shape_;
+  GemmCoord cluster_shape_;
+
+  // Version of initialize that takes in as input the number of CTAs in the M
+  // and N and L dimensions. This is useful for calculating the tiled shape when
+  // a mode of problem and/or CTA shape has rank > 1, for which using CuTe
+  // algebra for calculating tile shapes is easiest.
+  void initialize(
+      dim3 problem_blocks,
+      GemmCoord cta_shape,
+      GemmCoord cluster_shape,
+      KernelHardwareInfo const& hw_info,
+      int max_swizzle_size,
+      RasterOrderOptions raster_order_option) {
+    CUTLASS_UNUSED(hw_info);
+
+    // Round up to nearest multiple of swizzle_size along each mode
+    auto log_swizzle_size = get_log_swizzle_size(problem_blocks.x, problem_blocks.y, max_swizzle_size);
+    auto problem_blocks_m = round_up(problem_blocks.x, (1 << log_swizzle_size) * cluster_shape.m());
+    auto problem_blocks_n = round_up(problem_blocks.y, (1 << log_swizzle_size) * cluster_shape.n());
+
+    RasterOrder raster_order = get_rasterization_order(problem_blocks_m, problem_blocks_n, raster_order_option);
+
+    //
+    // Set members
+    //
+    cta_shape_ = cta_shape;
+    cluster_shape_ = cluster_shape;
+
+    blocks_across_problem_ = problem_blocks.x * problem_blocks.y * problem_blocks.z;
+    pre_processed_problem_shapes = false;
+    log_swizzle_size_ = log_swizzle_size;
+    raster_order_ = raster_order;
+
+    if (raster_order == RasterOrder::AlongN) {
+      divmod_cluster_shape_major_ = FastDivmodU64Pow2(cluster_shape.n());
+      divmod_cluster_shape_minor_ = FastDivmodU64Pow2(cluster_shape.m());
+    } else {
+      divmod_cluster_shape_major_ = FastDivmodU64Pow2(cluster_shape.m());
+      divmod_cluster_shape_minor_ = FastDivmodU64Pow2(cluster_shape.n());
+    }
+
+    divmod_cta_shape_m_ = FastDivmodU64(cta_shape_.m());
+    divmod_cta_shape_n_ = FastDivmodU64(cta_shape_.n());
+  }
+
+  // Version of get_tiled_cta_shape_mnl that takes in as input the number of
+  // CTAs in the M and N dimensions. This is useful for calculating the tiled
+  // shape when a mode of problem and/or CTA shape has rank > 1, for which using
+  // CuTe algebra for calculating tile shapes is easiest.
+  CUTLASS_HOST_DEVICE
+  static dim3 get_tiled_cta_shape_mnl(GemmCoord cluster_shape, uint32_t cta_m, uint32_t cta_n) {
+    // Round up to nearest multiple of cluster dim along each mode
+    auto problem_blocks_m = ((cta_m + cluster_shape.m() - 1) / cluster_shape.m()) * cluster_shape.m();
+    auto problem_blocks_n = ((cta_n + cluster_shape.n() - 1) / cluster_shape.n()) * cluster_shape.n();
+
+    return {
+        static_cast<uint32_t>(cta_m),
+        static_cast<uint32_t>(cta_n),
+        static_cast<uint32_t>(1)  // Only a single batch per group is currently supported
+    };
+  }
+
+  // Version of get_grid_shape that takes in as input the number of CTAs in the
+  // M and N and L dimensions. This is useful for calculating the tiled shape
+  // when a mode of problem and/or CTA shape has rank > 1, for which using CuTe
+  // algebra for calculating tile shapes is easiest.
+  CUTLASS_HOST_DEVICE static dim3 get_grid_shape(
+      dim3 problem_blocks,
+      GemmCoord cluster_shape,
+      KernelHardwareInfo hw_info,
+      int max_swizzle_size,
+      RasterOrderOptions raster_order_option,
+      bool truncate_by_problem_size = true) {
+    int const sm_count = hw_info.sm_count;
+    int const max_active_clusters = hw_info.max_active_clusters;
+
+    // Round up to nearest multiple of swizzle_size along each mode
+    auto log_swizzle_size = get_log_swizzle_size(problem_blocks.x, problem_blocks.y, max_swizzle_size);
+    auto problem_blocks_m = round_up(problem_blocks.x, (1 << log_swizzle_size) * cluster_shape.m());
+    auto problem_blocks_n = round_up(problem_blocks.y, (1 << log_swizzle_size) * cluster_shape.n());
+
+    int problem_blocks_total = problem_blocks_m * problem_blocks_n * problem_blocks.z;
+
+    RasterOrder raster_order = get_rasterization_order(problem_blocks_m, problem_blocks_n, raster_order_option);
+
+    dim3 launch_grid;
+
+    if (raster_order == RasterOrder::AlongN) {
+      launch_grid = dim3(cluster_shape.m(), 1, 1);
+    } else {
+      launch_grid = dim3(1, cluster_shape.n(), 1);
+    }
+
+    auto possibly_truncate = [&](int x, int y) {
+      if (truncate_by_problem_size) {
+        return platform::min(x, y);
+      } else {
+        return x;
+      }
+    };
+
+    // The else path is generic, however, we can avoid some divs if we know
+    // cluster size is 1
+    auto cluster_size = cluster_shape.m() * cluster_shape.n();
+    if (cluster_size == 1) {
+      if (raster_order == RasterOrder::AlongN) {
+        launch_grid.y = possibly_truncate(sm_count, problem_blocks_total);
+      } else {
+        launch_grid.x = possibly_truncate(sm_count, problem_blocks_total);
+      }
+    }
+    // In case the maximum number of clusters that could co-exist on the target
+    // device is already calculated using cudaOccupancyMaxActiveClusters
+    else if (max_active_clusters != 0 && max_active_clusters * cluster_size <= sm_count) {
+      if (raster_order == RasterOrder::AlongN) {
+        launch_grid.y = max_active_clusters * cluster_shape.n();
+      } else {
+        launch_grid.x = max_active_clusters * cluster_shape.m();
+      }
+      CUTLASS_TRACE_HOST(
+          "get_grid_shape(): Proposed GridDims by the scheduler using "
+          "cudaOccupancyMaxActiveClusters = "
+          "("
+          << launch_grid.x << ", " << launch_grid.y << ", " << launch_grid.z << ")\n");
+    } else {
+      // Optimal grid size calculation is based on
+      // GH100: 8 GPCs, 72 TPCs (9 TPCs/GPC), 2 SMs/TPC, 144 SMs per full GPU
+      // Hence, maximum SMs per GPC = 18
+      constexpr int max_sm_per_gpc = 18;
+      int cta_per_device = get_max_cta_occupancy(max_sm_per_gpc, cluster_shape, sm_count);
+
+      if (raster_order == RasterOrder::AlongN) {
+        launch_grid.y = possibly_truncate(cta_per_device / cluster_shape.m(), problem_blocks_total / cluster_shape.m());
+      } else {
+        launch_grid.x = possibly_truncate(cta_per_device / cluster_shape.n(), problem_blocks_total / cluster_shape.n());
+      }
+      CUTLASS_TRACE_HOST(
+          "get_grid_shape(): Proposed GridDims by the scheduler using "
+          "heuristics = "
+          "("
+          << launch_grid.x << ", " << launch_grid.y << ", " << launch_grid.z << ")\n");
+    }
+    return launch_grid;
+  }
+
+  CUTLASS_HOST_DEVICE
+  static int32_t get_log_swizzle_size(int problem_ctas_m, int problem_ctas_n, int max_swizzle_size) {
+    int min_cta_dim = platform::min(problem_ctas_m, problem_ctas_n);
+    if (max_swizzle_size >= 8 && min_cta_dim >= 6) {
+      return 3;
+    } else if (max_swizzle_size >= 4 && min_cta_dim >= 3) {
+      return 2;
+    } else if (max_swizzle_size >= 2 && min_cta_dim >= 2) {
+      return 1;
+    } else {
+      return 0;
+    }
+  }
+
+  CUTLASS_HOST_DEVICE
+  static RasterOrder
+  get_rasterization_order(uint32_t tiles_m, uint32_t tiles_n, RasterOrderOptions raster_order_option) {
+    if (raster_order_option == RasterOrderOptions::Heuristic) {
+      if (tiles_n > tiles_m) {
+        return RasterOrder::AlongM;
+      } else {
+        return RasterOrder::AlongN;
+      }
+    } else {
+      switch (raster_order_option) {
+        case RasterOrderOptions::AlongN:
+          return RasterOrder::AlongN;
+          break;
+        default:
+          return RasterOrder::AlongM;
+      }
+    }
+  }
+};
+
+////////////////////////////////////////////////////////////////////////////////
+
+}  // namespace detail
+}  // namespace kernel
+}  // namespace gemm
+}  // namespace cutlass
diff --git a/src/sycl/xe35/nvfp4/device/grouped_gemm_runner.hpp b/src/sycl/xe35/nvfp4/device/grouped_gemm_runner.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..96b73c88cd1e95b7354ec3008e4482570b969153
--- /dev/null
+++ b/src/sycl/xe35/nvfp4/device/grouped_gemm_runner.hpp
@@ -0,0 +1,234 @@
+/* Copyright (c) 2025 Intel Corporation
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Header-only form of the vllm-xpu-kernels Xe3 grouped-GEMM launcher
+ * (csrc/xpu/grouped_gemm/xe_3/grouped_gemm_kernel.cpp @ 48313ef). The upstream
+ * file is a .cpp with an explicit INSTANTIATE_KERNEL list for all 38 dtype
+ * policies because the dispatch lives in a separate translation unit; here the
+ * dispatch and the launcher share one TU, so kernel_functor<> is instantiated
+ * implicitly and only the policies actually referenced are code-generated.
+ *
+ * Behavioural changes from upstream: a cutlass error raises a torch exception
+ * instead of calling exit(EXIT_FAILURE), and a policy that asks for a scheduler
+ * workspace is rejected instead of silently getting an unsafe one (see run()).
+ */
+#pragma once
+
+#include <ATen/ATen.h>
+
+#include "sycl/xe35/nvfp4/collective/moe_dtype_policy.hpp"
+
+namespace sgl_kernel::vllm_grouped_gemm_xe35 {
+
+using namespace cute;
+
+#define SGL_GG_CUTLASS_CHECK(status)                                                                                 \
+  {                                                                                                                  \
+    cutlass::Status error = (status);                                                                                \
+    TORCH_CHECK(error == cutlass::Status::kSuccess, "cutlass grouped GEMM failed: ", cutlassGetStatusString(error)); \
+  }
+
+template <typename Gemm, bool NeedScale>
+struct ElementScaleSelector_xe35 {
+  using A = void;
+  using B = void;
+};
+
+template <typename Gemm>
+struct ElementScaleSelector_xe35<Gemm, true> {
+  using A = typename Gemm::CollectiveMainloop::ElementScaleA;
+  using B = typename Gemm::CollectiveMainloop::ElementScaleB;
+};
+
+template <class Gemm, bool NeedScale>
+struct GroupedGemmRunner_xe35 {
+  using ElementA = typename Gemm::ElementA;
+  using ElementB = typename Gemm::ElementB;
+  using ElementC = typename Gemm::ElementC;
+
+  using CollectiveMainloop = typename Gemm::CollectiveMainloop;
+  using CollectiveEpilogue = typename Gemm::CollectiveEpilogue;
+  using ElementOutput = typename CollectiveEpilogue::ElementOutput;
+  using ElementAccumulator = typename Gemm::ElementAccumulator;
+
+  using ElementScaleA = typename ElementScaleSelector_xe35<Gemm, NeedScale>::A;
+  using ElementScaleB = typename ElementScaleSelector_xe35<Gemm, NeedScale>::B;
+
+  typename Gemm::Arguments args_from_mainloop_options(
+      const cutlass::KernelHardwareInfo& hw_info,
+      int const* rows_per_expert,
+      typename CollectiveMainloop::Arguments const& mainloop_args,
+      const ElementC* ptr_C,
+      ElementOutput* ptr_D,
+      int64_t N,
+      int64_t K,
+      int64_t groups) {
+    typename Gemm::Arguments arguments;
+    decltype(arguments.epilogue.thread) fusion_args;
+
+    fusion_args.alpha = 1;
+    fusion_args.beta = ptr_C ? 1 : 0;
+    fusion_args.alpha_ptr = nullptr;
+    fusion_args.beta_ptr = nullptr;
+    fusion_args.alpha_ptr_array = nullptr;
+    fusion_args.beta_ptr_array = nullptr;
+    // One alpha and beta per each group
+    fusion_args.dAlpha = {cute::_0{}, cute::_0{}, 0};
+    fusion_args.dBeta = {cute::_0{}, cute::_0{}, 0};
+    using RasterOrderOptions = typename cutlass::gemm::kernel::detail::PersistentTileSchedulerMoE_xe35::RasterOrderOptions;
+
+    // Per-GEMM problem shape info may only exist on the device.
+    arguments = typename Gemm::Arguments{
+        cutlass::gemm::GemmUniversalMode::kGrouped,
+        mainloop_args,
+        {fusion_args, ptr_C, ptr_D},
+        rows_per_expert,
+        N,
+        K,
+        groups,
+        hw_info,
+        {1, RasterOrderOptions::AlongN}};
+    return arguments;
+  }
+
+  typename Gemm::Arguments args_from_options(
+      const cutlass::KernelHardwareInfo& hw_info,
+      int const* rows_per_expert,
+      const ElementA* ptr_A,
+      const ElementScaleA* ptr_A_scale,
+      const ElementB* ptr_B,
+      const ElementScaleB* ptr_B_scale,
+      const ElementC* ptr_C,
+      ElementOutput* ptr_D,
+      int64_t N,
+      int64_t K,
+      int64_t groups,
+      int block_size) {
+    if constexpr (!NeedScale) {
+      return args_from_mainloop_options(
+          hw_info, rows_per_expert, typename CollectiveMainloop::Arguments{ptr_A, ptr_B}, ptr_C, ptr_D, N, K, groups);
+    } else {
+      return args_from_mainloop_options(
+          hw_info,
+          rows_per_expert,
+          typename CollectiveMainloop::Arguments{ptr_A, ptr_B, ptr_A_scale, ptr_B_scale, block_size},
+          ptr_C,
+          ptr_D,
+          N,
+          K,
+          groups);
+    }
+  }
+
+  cutlass::Status run_with_mainloop(
+      sycl::queue& stream,
+      const cutlass::KernelHardwareInfo& hw_info,
+      int const* rows_per_expert,
+      typename CollectiveMainloop::Arguments const& mainloop_args,
+      const ElementC* ptr_C,
+      ElementOutput* ptr_D,
+      int64_t N,
+      int64_t K,
+      int64_t groups) {
+    Gemm gemm_op;
+
+    auto arguments = args_from_mainloop_options(hw_info, rows_per_expert, mainloop_args, ptr_C, ptr_D, N, K, groups);
+
+    size_t workspace_size = Gemm::get_workspace_size(arguments);
+    // PersistentTileSchedulerMoE_xe35 asks for no workspace, and this launcher depends on
+    // that: `allocation` comes from syclcompat's default queue rather than the caller's
+    // torch stream, and its RAII free runs as soon as `run()` returns -- i.e. while the
+    // kernel it belongs to may still be executing. A non-zero workspace here would be
+    // a use-after-free plus a cross-queue allocation, which is the hazard the FMHA path
+    // was fixed for (see flash_attentionXe35_common.hpp). Wire it to the torch stream
+    // allocator before enabling any policy that needs one.
+    TORCH_CHECK(
+        workspace_size == 0,
+        "moe grouped GEMM: this policy wants a ",
+        workspace_size,
+        "-byte workspace, which this launcher cannot allocate safely on the caller's stream");
+    cutlass::device_memory::allocation<uint8_t> workspace(workspace_size);
+
+    SGL_GG_CUTLASS_CHECK(gemm_op.can_implement(arguments));
+    SGL_GG_CUTLASS_CHECK(gemm_op.initialize(arguments, workspace.get(), &stream));
+    SGL_GG_CUTLASS_CHECK(gemm_op.run(&stream));
+    return cutlass::Status::kSuccess;
+  }
+
+  cutlass::Status
+  run(sycl::queue& stream,
+      const cutlass::KernelHardwareInfo& hw_info,
+      int const* rows_per_expert,
+      const ElementA* ptr_A,
+      const ElementScaleA* ptr_A_scale,
+      const ElementB* ptr_B,
+      const ElementScaleB* ptr_B_scale,
+      const ElementC* ptr_C,
+      ElementOutput* ptr_D,
+      int64_t N,
+      int64_t K,
+      int64_t groups,
+      int block_size) {
+    if constexpr (!NeedScale) {
+      return run_with_mainloop(
+          stream,
+          hw_info,
+          rows_per_expert,
+          typename CollectiveMainloop::Arguments{ptr_A, ptr_B},
+          ptr_C,
+          ptr_D,
+          N,
+          K,
+          groups);
+    } else {
+      return run_with_mainloop(
+          stream,
+          hw_info,
+          rows_per_expert,
+          typename CollectiveMainloop::Arguments{ptr_A, ptr_B, ptr_A_scale, ptr_B_scale, block_size},
+          ptr_C,
+          ptr_D,
+          N,
+          K,
+          groups);
+    }
+  }
+};
+
+template <class moe_policy>
+void kernel_functor(
+    sycl::queue& stream,
+    void* ptr_A,
+    void* ptr_A_scale,
+    void* ptr_B,
+    void* ptr_B_scale,
+    void* ptr_bias,
+    void* ptr_D,
+    void* rows_per_expert,
+    int64_t N,
+    int64_t K,
+    int64_t groups) {
+  // Number of Xe cores; the tile scheduler sizes its persistent grid from it.
+  cutlass::KernelHardwareInfo hw_info;
+  hw_info.sm_count = cutlass::KernelHardwareInfo::query_device_multiprocessor_count(hw_info.device_id);
+
+  using Gemm = typename moe_policy::Gemm;
+  GroupedGemmRunner_xe35<Gemm, moe_policy::NeedScale> runner;
+
+  runner.run(
+      stream,
+      hw_info,
+      reinterpret_cast<const int*>(rows_per_expert),
+      reinterpret_cast<const typename moe_policy::ElementA*>(ptr_A),
+      reinterpret_cast<const typename moe_policy::ElementScaleA*>(ptr_A_scale),
+      reinterpret_cast<const typename moe_policy::ElementB*>(ptr_B),
+      reinterpret_cast<const typename moe_policy::ElementScaleB*>(ptr_B_scale),
+      reinterpret_cast<const typename moe_policy::ElementAccumulator*>(ptr_bias),
+      reinterpret_cast<typename moe_policy::ElementOutput*>(ptr_D),
+      N,
+      K,
+      groups,
+      moe_policy::BlockSize);
+}
+
+}  // namespace sgl_kernel::vllm_grouped_gemm_xe35
diff --git a/src/sycl/xe35/nvfp4/payload_compat.hpp b/src/sycl/xe35/nvfp4/payload_compat.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..04b0d0396e3346de2fcaa42f761694f0f4926387
--- /dev/null
+++ b/src/sycl/xe35/nvfp4/payload_compat.hpp
@@ -0,0 +1,227 @@
+#pragma once
+
+#include <cute/atom/copy_traits_xe_2d.hpp>
+
+namespace sgl_xpu_xe35 {
+
+using namespace cute;
+
+template <int N, class BaseT = void>
+struct Nvfp4PreparedPayloads_xe35 {
+  int* payloads[N];
+
+  template <int Field>
+  CUTE_DEVICE static void add_payload_field(int* payload, int32_t delta) {
+    static_assert(Field == 5 || Field == 6, "Only block X/Y payload fields can be updated.");
+#ifdef __SYCL_DEVICE_ONLY__
+    asm volatile(
+        "{\n"
+        ".decl PAYLOAD_D v_type=G type=D num_elts=8 alias=<%0,0>\n"
+        ".decl DELTA_D v_type=G type=D num_elts=1 alias=<%1,0>\n"
+        "add (M1_NM, 1) PAYLOAD_D(0,%2)<1> PAYLOAD_D(0,%2)<0;1,0> DELTA_D(0,0)<0;1,0>\n"
+        "}\n"
+        :
+        : "rw.u"(payload), "rw.u"(delta), "P"(Field));
+#else
+    (void) payload;
+    (void) delta;
+    CUTE_INVALID_CONTROL_PATH("Xe 2D payload updates are only available on SYCL device.");
+#endif
+  }
+
+  template <class Coord>
+  CUTE_DEVICE Nvfp4PreparedPayloads_xe35& operator+=(Coord const& delta) {
+    using Op = typename BaseT::CopyOp;
+    static_assert(!BaseT::nontrivial_tiled_strides,
+                  "Payload updates are only supported for modes handled by block 2D messages.");
+#ifdef __SYCL_DEVICE_ONLY__
+    auto dx = get<decltype(BaseT::get_x_mode())::value>(delta);
+    auto dy = get<decltype(BaseT::get_y_mode())::value>(delta);
+    CUTE_UNROLL
+    for (int payload_index = 0; payload_index < N; ++payload_index) {
+      if constexpr (!is_constant_v<0, decltype(dx)>) {
+        add_payload_field<5>(payloads[payload_index], int32_t(dx) * BaseT::ValBits / Op::CopyBits);
+      }
+      if constexpr (!is_constant_v<0, decltype(dy)>) {
+        add_payload_field<6>(payloads[payload_index], int32_t(dy));
+      }
+    }
+#else
+    (void) delta;
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    return *this;
+  }
+
+  template <int Step>
+  CUTE_DEVICE Nvfp4PreparedPayloads_xe35& operator+=(C<Step>) {
+    return *this += make_coord(_0{}, C<Step>{});
+  }
+
+  CUTE_DEVICE Nvfp4PreparedPayloads_xe35& operator+=(int step) {
+    return *this += make_coord(_0{}, step);
+  }
+};
+
+namespace payload_detail_xe35 {
+
+template <class Op, class XMode, class YMode, typename ValType, typename TiledStrides>
+CUTE_HOST_DEVICE
+Xe2DTraitsBase<Op, XMode, YMode, ValType, TiledStrides> const&
+as_xe2d_base(Xe2DTraitsBase<Op, XMode, YMode, ValType, TiledStrides> const& o) {
+  return o;
+}
+
+template <int NumValDst, int N, class BaseT,
+          class SEngine, class SLayout>
+CUTE_DEVICE void
+prepare_payloads_xe35(BaseT const& base,
+                      Tensor<SEngine, SLayout> const& src,
+                      Nvfp4PreparedPayloads_xe35<N, BaseT>& payloads,
+                      int& idx)
+{
+  using Op    = typename BaseT::CopyOp;
+  constexpr int ValBits = BaseT::ValBits;
+
+  if constexpr (SLayout::rank == 1 && decltype(size(SLayout{}))::value == NumValDst) {
+#ifdef __SYCL_DEVICE_ONLY__
+    using XMode = decltype(BaseT::get_x_mode());
+    using YMode = decltype(BaseT::get_y_mode());
+    auto coord = src.data().coord_;
+    int32_t x = get<XMode::value>(coord) * ValBits / Op::CopyBits;
+    int32_t y = get<YMode::value>(coord);
+    uint64_t bp = base.base_ptr;
+    if constexpr (BaseT::nontrivial_tiled_strides) {
+      auto off = inner_product(coord, base.tiled_strides);
+      bp += (off * ValBits) >> 3;
+    }
+    payloads.payloads[idx] =
+        __builtin_IB_subgroup_copyBlock2DAddressPayload(base.payload);
+        __builtin_IB_subgroup_setBlock2DAddressPayloadBlockX(payloads.payloads[idx], x);
+        __builtin_IB_subgroup_setBlock2DAddressPayloadBlockY(payloads.payloads[idx], y);
+    if constexpr (BaseT::nontrivial_tiled_strides) {
+      __builtin_IB_subgroup_setBlock2DAddressPayloadBase(payloads.payloads[idx], bp);
+    }
+#else
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    ++idx;
+  } else if constexpr (SLayout::rank > 1) {
+    constexpr int R = SLayout::rank;
+    auto src_v = group_modes<1, R>(src);
+    auto src_null = nullspace(layout<1>(src_v));
+    auto src_n = zipped_divide(src_v, make_tile(shape<0>(src_v), src_null));
+    auto src_c = src_n(make_coord(_, Int<0>{}), make_coord(Int<0>{}, _));
+    constexpr int Rest = decltype(size<1>(src_c))::value;
+    CUTE_UNROLL
+    for (int payload_index = 0; payload_index < Rest; ++payload_index) {
+      auto s_i = src_c(_, payload_index);
+      prepare_payloads_xe35<NumValDst>(base, s_i, payloads, idx);
+    }
+  } else {
+    static_assert(is_tuple<decltype(shape<0>(SLayout{}))>::value,
+                  "Cannot peel further: V mode is atomic but size does not match NumValDst");
+    auto s_sub = tensor<0>(src);
+    prepare_payloads_xe35<NumValDst>(base, s_sub, payloads, idx);
+  }
+}
+
+template <int NumValDst, int N, class BaseT,
+          class DEngine, class DLayout>
+CUTE_DEVICE void
+copy_payloads_xe35(BaseT const& base,
+                   Tensor<DEngine, DLayout>& dst,
+                   Nvfp4PreparedPayloads_xe35<N, BaseT> const& payloads,
+                   int& idx)
+{
+  using Op    = typename BaseT::CopyOp;
+  constexpr int ValBits = BaseT::ValBits;
+
+  if constexpr (DLayout::rank == 1 && decltype(size(DLayout{}))::value == NumValDst) {
+#ifdef __SYCL_DEVICE_ONLY__
+    using ValT = int_byte_t<bits_to_bytes(ValBits)>;
+    Op::copy(payloads.payloads[idx],
+             const_cast<ValT*>(recast_ptr<ValT>(raw_pointer_cast(dst.data()))));
+#else
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    ++idx;
+  } else if constexpr (DLayout::rank > 1) {
+    constexpr int R = DLayout::rank;
+    auto dst_v = group_modes<1, R>(dst);
+    auto dst_null = nullspace(layout<1>(dst_v));
+    auto dst_n = zipped_divide(dst_v, make_tile(shape<0>(dst_v), dst_null));
+    auto dst_c = dst_n(make_coord(_, Int<0>{}), make_coord(Int<0>{}, _));
+    constexpr int Rest = decltype(size<1>(dst_c))::value;
+    CUTE_UNROLL
+    for (int payload_index = 0; payload_index < Rest; ++payload_index) {
+      auto d_i = dst_c(_, payload_index);
+      copy_payloads_xe35<NumValDst>(base, d_i, payloads, idx);
+    }
+  } else {
+    static_assert(is_tuple<decltype(shape<0>(DLayout{}))>::value,
+                  "Cannot peel further: V mode is atomic but size does not match NumValDst");
+    auto d_sub = tensor<0>(dst);
+    copy_payloads_xe35<NumValDst>(base, d_sub, payloads, idx);
+  }
+}
+
+} // namespace payload_detail_xe35
+
+template <class TiledCopy,
+          class Engine, class Layout>
+CUTE_DEVICE auto
+prepare_payloads_xe35(TiledCopy const& tiled_copy,
+                  Tensor<Engine, Layout> const& tensor)
+{
+  static_assert(is_counting_layout_v<Layout>, "tensor must be a coordinate tensor.");
+  auto const& base = payload_detail_xe35::as_xe2d_base(tiled_copy);
+  using BaseT = remove_cvref_t<decltype(base)>;
+  constexpr int NumValDst = decltype(size<1>(typename BaseT::Traits::DstLayout{}))::value / BaseT::ValBits;
+  constexpr int Total     = decltype(size(Layout{}))::value;
+  static_assert(Total % NumValDst == 0,
+                "src tensor size is not a multiple of per-atom size");
+  constexpr int N = Total / NumValDst;
+
+  Nvfp4PreparedPayloads_xe35<N, BaseT> prepared{};
+  int idx = 0;
+  payload_detail_xe35::prepare_payloads_xe35<NumValDst>(base, tensor, prepared, idx);
+  return prepared;
+}
+
+template <class TiledCopy, int N, class BaseT, class Engine, class Layout>
+CUTE_DEVICE void
+copy_payloads_xe35(TiledCopy const& tiled_copy,
+     Nvfp4PreparedPayloads_xe35<N, BaseT> const& prepared,
+     Tensor<Engine, Layout>& tensor)
+{
+  static_assert(is_rmem_v<Engine>, "tensor must be in registers.");
+  auto const& base = payload_detail_xe35::as_xe2d_base(tiled_copy);
+  constexpr int NumValDst = decltype(size<1>(typename BaseT::Traits::DstLayout{}))::value / BaseT::ValBits;
+
+  int idx = 0;
+  payload_detail_xe35::copy_payloads_xe35<NumValDst>(base, tensor, prepared, idx);
+}
+
+template <class TiledCopy, int N, class BaseT>
+CUTE_DEVICE void
+prefetch_payloads_xe35(TiledCopy const& tiled_copy,
+                       Nvfp4PreparedPayloads_xe35<N, BaseT> const& prepared)
+{
+  auto const& base = payload_detail_xe35::as_xe2d_base(tiled_copy);
+  using Op = typename BaseT::CopyOp;
+#ifdef __SYCL_DEVICE_ONLY__
+  CUTE_UNROLL
+  for (int payload_index = 0; payload_index < N; ++payload_index) {
+    Op::copy(prepared.payloads[payload_index]);
+  }
+#else
+  (void) base;
+  (void) prepared;
+  CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+}
+
+
+
+}
diff --git a/src/sycl/xe35/nvfp4_woq.cpp b/src/sycl/xe35/nvfp4_woq.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4865b7a83ec60862614a5575f0e96876a987705a
--- /dev/null
+++ b/src/sycl/xe35/nvfp4_woq.cpp
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ * NVFP4 weight-only-quantization (WoQ) support kernels.
+ *
+ * Xe3P has no native NVFP4 MMA: the `bdpas` block-scaled instruction only
+ * accepts UE8M0 scale factors with a fixed block size of 32, while NVFP4 uses
+ * E4M3 scale factors with block size 16 plus one FP32 per-tensor global scale.
+ * NVFP4 weights are therefore emulated by dequantizing to BF16 and
+ * requantizing to MXFP8, after which a normal MXFP8 block-scaled GEMM runs.
+ *
+ * nvfp4_woq_prep_xe35 rewrites only the *scales* into the pair the fused mainloop
+ * consumes, leaving the 4-bit payload untouched in memory:
+ *
+ *   c    (E, N, K/16) bf16   per-16 multiplier
+ *   sfmx (E, K/32, N) uint8  UE8M0 per-32 scale
+ *
+ * sfmx is MN-major because it feeds the Xe block-2D scale load unchanged; c is
+ * row-major because the mainloop reads a lane's K/16 entries for one N as a
+ * short contiguous vector.
+ *
+ * Numerics contract (see tests/nvfp4_utils.py for the reference):
+ *
+ *   s_j    = gs_dq * float(sf16_j)                     per-16 dequant scale
+ *   amax32 = 6 * max(s_2j, s_2j+1)                     E2M1 magnitude bound
+ *   kexp   = min k such that 448 * 2^k >= amax32       UE8M0 exponent
+ *   c_j    = bf16(s_j * 2^-kexp)                       per-16 multiplier
+ *   w_mx   = e4m3_rne(float(c_j) * float(e2m1_val))    MXFP8 value
+ *
+ * `6` is the largest E2M1 magnitude, so `amax32` upper-bounds the group and
+ * requantization never clips.  NVFP4 quantizers pick sf16 = block_amax / 6,
+ * which makes the bound tight in practice.  Deriving kexp from the scales alone
+ * (rather than from the payload) is what lets this run without touching the
+ * 4-bit data at all.
+ */
+
+#include <ATen/ATen.h>
+#include <c10/xpu/XPUStream.h>
+#include <torch/all.h>
+#include <sgl_kernel/xe35/nvfp4_woq.h>
+
+#include <cstdint>
+#include <sycl/sycl.hpp>
+
+#include "cutlass/float8.h"
+
+namespace at::native::xpu {
+
+namespace {
+
+constexpr int UE8M0_BIAS = 127;
+constexpr float E2M1_MAX = 6.0f;  // largest E2M1 magnitude; bounds a group
+
+/// Smallest integer k with 448 * 2^k >= amax, exactly (no log2 round-off).
+///
+/// frexp gives amax = m * 2^e with m in [0.5, 1).  448 == 1.75 * 2^8, so
+/// 448 * 2^k >= m * 2^e  <=>  1.75 >= m * 2^(e - 8 - k), and since m < 1 the
+/// smallest admissible k is e - 9 when 2m <= 1.75 and e - 8 otherwise.
+inline int ue8m0_exponent_xe35(float amax) {
+  if (!(amax > 0.0f)) {
+    return 0;
+  }
+  int e = 0;
+  const float m = sycl::frexp(amax, &e);
+  const int k = (m <= 0.875f) ? (e - 9) : (e - 8);
+  return sycl::clamp(k, -UE8M0_BIAS, 127);
+}
+
+/// Construct 2^exponent exactly for the full UE8M0 exponent range.
+inline float power_of_two_xe35(int exponent) {
+  // IEEE-754 encodes 2^-127 as a subnormal; all remaining values use a biased
+  // normal exponent. Callers pass only [-127, 127].
+  const uint32_t bits = exponent == -127 ? 0x00400000u : static_cast<uint32_t>(exponent + 127) << 23;
+  return sycl::bit_cast<float>(bits);
+}
+
+/// Convert a finite float to BF16 bits using round-to-nearest, ties-to-even.
+inline uint16_t float_to_bf16_rne_bits(float value) {
+  const uint32_t bits = sycl::bit_cast<uint32_t>(value);
+  const uint32_t rounding_bias = 0x7fffu + ((bits >> 16) & 1u);
+  return static_cast<uint16_t>((bits + rounding_bias) >> 16);
+}
+
+struct NvFp4WoqPrepKernel_xe35;
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// nvfp4_woq_prep_xe35
+// ---------------------------------------------------------------------------
+//
+// One work-item per (expert, n, 32-group).  Scales only — the 4-bit payload is
+// consumed straight from the checkpoint by the fused mainloop.  sfmx comes out
+// MN-major so the mainloop can load it with the same Xe block-2D scale atoms
+// the MXFP8 path already uses; c comes out row-major (N, K/16) so each lane's
+// per-16 multipliers for one N are contiguous.
+SGL_KERNEL_EXPORT void nvfp4_woq_prep_xe35(
+    torch::Tensor& out_c, torch::Tensor& out_sfmx, const torch::Tensor& w_s, const torch::Tensor& w_gs) {
+  TORCH_CHECK(w_s.device().is_xpu(), "nvfp4_woq_prep_xe35: w_s must be on XPU");
+  const auto device = w_s.device();
+  TORCH_CHECK(w_gs.device() == device, "nvfp4_woq_prep_xe35: w_gs must be on the same XPU device as w_s");
+  TORCH_CHECK(out_c.device() == device, "nvfp4_woq_prep_xe35: out_c must be on the same XPU device as w_s");
+  TORCH_CHECK(out_sfmx.device() == device, "nvfp4_woq_prep_xe35: out_sfmx must be on the same XPU device as w_s");
+  TORCH_CHECK(w_s.dim() == 3, "nvfp4_woq_prep_xe35: w_s must be (E, N, K/16), got ", w_s.dim(), "D");
+  TORCH_CHECK(w_s.scalar_type() == torch::kFloat8_e4m3fn, "nvfp4_woq_prep_xe35: w_s must be float8_e4m3fn");
+  TORCH_CHECK(w_gs.scalar_type() == torch::kFloat32, "nvfp4_woq_prep_xe35: w_gs must be float32");
+  TORCH_CHECK(out_c.scalar_type() == torch::kBFloat16, "nvfp4_woq_prep_xe35: out_c must be bfloat16");
+  TORCH_CHECK(out_sfmx.scalar_type() == torch::kUInt8, "nvfp4_woq_prep_xe35: out_sfmx must be uint8 (UE8M0)");
+  TORCH_CHECK(w_s.is_contiguous(), "nvfp4_woq_prep_xe35: w_s must be contiguous");
+  TORCH_CHECK(w_gs.is_contiguous(), "nvfp4_woq_prep_xe35: w_gs must be contiguous");
+  TORCH_CHECK(out_c.is_contiguous() && out_sfmx.is_contiguous(), "nvfp4_woq_prep_xe35: outputs must be contiguous");
+
+  const int64_t E = w_s.size(0);
+  const int64_t N = w_s.size(1);
+  const int64_t sk16 = w_s.size(2);
+  TORCH_CHECK(sk16 % 2 == 0, "nvfp4_woq_prep_xe35: K/16 must be even (K must be a multiple of 32), got ", sk16);
+  const int64_t sk32 = sk16 / 2;
+
+  TORCH_CHECK(w_gs.numel() == E, "nvfp4_woq_prep_xe35: w_gs must have E entries, got ", w_gs.numel());
+  TORCH_CHECK(
+      out_c.dim() == 3 && out_c.size(0) == E && out_c.size(1) == N && out_c.size(2) == sk16,
+      "nvfp4_woq_prep_xe35: out_c must be (E, N, K/16)");
+  TORCH_CHECK(
+      out_sfmx.dim() == 3 && out_sfmx.size(0) == E && out_sfmx.size(1) == sk32 && out_sfmx.size(2) == N,
+      "nvfp4_woq_prep_xe35: out_sfmx must be (E, K/32, N)");
+
+  const int64_t total = E * N * sk32;
+  if (total == 0) {
+    return;
+  }
+
+  const uint8_t* src_s = reinterpret_cast<const uint8_t*>(w_s.data_ptr());
+  const float* src_gs = w_gs.data_ptr<float>();
+  auto* dst_c = reinterpret_cast<uint16_t*>(out_c.data_ptr());
+  uint8_t* dst_sfmx = reinterpret_cast<uint8_t*>(out_sfmx.data_ptr());
+
+  auto& q = at::xpu::getCurrentXPUStream(device.index()).queue();
+  const size_t wg = 256;
+  const size_t global = ((static_cast<size_t>(total) + wg - 1) / wg) * wg;
+
+  q.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for<NvFp4WoqPrepKernel_xe35>(
+        sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(wg)), [=](sycl::nd_item<1> item) {
+          const int64_t gid = static_cast<int64_t>(item.get_global_linear_id());
+          if (gid >= total) {
+            return;
+          }
+          // n is the fastest-varying coordinate so the MN-major stores coalesce.
+          const int64_t n = gid % N;
+          const int64_t rest = gid / N;
+          const int64_t g32 = rest % sk32;
+          const int64_t e = rest / sk32;
+
+          const int64_t sf_base = (e * N + n) * sk16 + 2 * g32;
+          const float gs = src_gs[e];
+          const auto* sf = reinterpret_cast<const cutlass::float_e4m3_t*>(src_s);
+          const float s0 = static_cast<float>(sf[sf_base]) * gs;
+          const float s1 = static_cast<float>(sf[sf_base + 1]) * gs;
+
+          const int kexp = ue8m0_exponent_xe35(E2M1_MAX * sycl::fmax(s0, s1));
+          const float inv = power_of_two_xe35(-kexp);
+
+          dst_sfmx[(e * sk32 + g32) * N + n] = static_cast<uint8_t>(kexp + UE8M0_BIAS);
+          auto* c_row = dst_c + (e * N + n) * sk16 + 2 * g32;
+          c_row[0] = float_to_bf16_rne_bits(s0 * inv);
+          c_row[1] = float_to_bf16_rne_bits(s1 * inv);
+        });
+  });
+}
+
+}  // namespace at::native::xpu
