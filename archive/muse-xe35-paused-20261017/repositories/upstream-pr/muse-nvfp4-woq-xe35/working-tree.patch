diff --git a/python/sgl_kernel/nvfp4.py b/python/sgl_kernel/nvfp4.py
new file mode 100644
index 0000000000000000000000000000000000000000..6d97946371eebb30763f8b14dc29c0848fadaab4
--- /dev/null
+++ b/python/sgl_kernel/nvfp4.py
@@ -0,0 +1,139 @@
+"""NVFP4 weight-only-quantization (WoQ) helpers for Intel XPU.
+
+Xe3P has no native NVFP4 MMA — the ``bdpas`` block-scaled instruction only
+accepts UE8M0 scale factors with a fixed block size of 32, while NVFP4 uses
+E4M3 scale factors with block size 16 plus one FP32 per-tensor global scale.
+NVFP4 weights can therefore be emulated either by requantizing to MXFP8 or by
+dequantizing directly into a BF16 MMA fragment. Both paths leave the packed
+4-bit payload in memory.
+
+``nvfp4_woq_prep_xe35`` rewrites only the scales into the ``(c, sfmx)`` pair consumed
+by the fused WoQ mainloop, which keeps the 4-bit payload in memory and
+requantizes inside the GEMM.  It adds ~1/32 byte per weight element on top of
+NVFP4 and is the only weight preprocessing the path needs; the E2M1 payload is
+consumed exactly as the checkpoint ships it.
+
+See tests/nvfp4_utils.py for the reference implementation of the numerics and
+src/sycl/xe35/nvfp4_woq.cpp for the device kernel.
+"""
+
+from typing import Tuple
+
+import torch
+
+NVFP4_BLOCK_SIZE = 16
+MXFP8_BLOCK_SIZE = 32
+
+
+def nvfp4_woq_prep_xe35(
+    w_s: torch.Tensor,
+    w_gs: torch.Tensor,
+    out_c: torch.Tensor = None,
+    out_sfmx: torch.Tensor = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """One-time scale prep for the fused NVFP4 WoQ mainloop.
+
+    Args:
+        w_s: (E, N, K/16) float8_e4m3fn NVFP4 block scales.
+        w_gs: (E,) float32 dequant multiplier.
+
+    Returns:
+        ``(c, sfmx)`` where ``c`` is (E, N, K/16) bfloat16 — the per-16
+        multiplier with the global scale folded in, row-major so a lane reads
+        its entries for one N contiguously — and ``sfmx`` is (E, K/32, N) uint8
+        UE8M0, MN-major, the per-32 requantization scale handed straight to
+        ``bdpas`` through the ordinary Xe block-2D scale load.
+    """
+    assert w_s.dim() == 3, f"w_s must be (E, N, K/16), got {tuple(w_s.shape)}"
+    assert (
+        w_s.dtype == torch.float8_e4m3fn
+    ), f"w_s must be float8_e4m3fn, got {w_s.dtype}"
+    assert w_gs.dtype == torch.float32, f"w_gs must be float32, got {w_gs.dtype}"
+    e, n, sk16 = w_s.shape
+    assert sk16 % 2 == 0, f"K/16 ({sk16}) must be even, i.e. K a multiple of 32"
+    assert w_gs.numel() == e, f"w_gs must have {e} entries, got {w_gs.numel()}"
+
+    if out_c is None:
+        out_c = torch.empty((e, n, sk16), device=w_s.device, dtype=torch.bfloat16)
+    if out_sfmx is None:
+        out_sfmx = torch.empty((e, sk16 // 2, n), device=w_s.device, dtype=torch.uint8)
+    torch.ops.sgl_kernel.nvfp4_woq_prep_xe35.default(out_c, out_sfmx, w_s, w_gs)
+    return out_c, out_sfmx
+
+
+def nvfp4_woq_mxfp8_scaled_grouped_mm_xe35(
+    output: torch.Tensor,
+    a: torch.Tensor,
+    b: torch.Tensor,
+    scales_a: torch.Tensor,
+    sfmx_b: torch.Tensor,
+    c_b: torch.Tensor,
+    problem_sizes: torch.Tensor,
+    expert_offsets: torch.Tensor,
+    workspace: torch.Tensor,
+) -> None:
+    """Fused NVFP4 weight-only-quantized MXFP8 grouped GEMM (Xe3P / CRI only).
+
+    B stays NVFP4 in memory; the mainloop dequantizes it to BF16 and
+    requantizes to MXFP8 in registers, then runs a normal MXFP8 ``bdpas``.
+
+    Args:
+        output: (sum_m, N) float32, ragged over experts. Zero-initialized.
+        a: (sum_m, K) float8_e4m3fn MXFP8 activations.
+        b: (E, N, K/2) uint8 packed E2M1 weights.
+        scales_a: (sum_m, K/32) uint8 UE8M0 activation scales, row-major.
+        sfmx_b: (E, K/32, N) uint8 UE8M0, MN-major — from :func:`nvfp4_woq_prep_xe35`.
+        c_b: (E, N, K/16) bfloat16 per-16 multiplier — from :func:`nvfp4_woq_prep_xe35`.
+        problem_sizes: (E, 3) int32 per-expert (M, N, K).
+        expert_offsets: (E,) int32 cumulative row starts into the flat A/output.
+        workspace: uint8 scratch for the grouped GEMM.
+
+    Shape constraints (checked in C++): ``K`` must be a multiple of the 64-wide
+    workgroup K tile, and ``N * (K // 32)`` must be a multiple of 64 so that each
+    expert's slice of ``sfmx_b`` starts on a 64-byte boundary, which the Xe
+    block-2D scale load requires.  Per-expert M is unconstrained.
+    """
+    from sgl_kernel import is_xe3_arch
+
+    assert (
+        is_xe3_arch()
+    ), "nvfp4_woq_mxfp8_scaled_grouped_mm_xe35 is only supported on CRI (Xe3P) devices"
+    torch.ops.sgl_kernel.nvfp4_woq_mxfp8_scaled_grouped_mm_xe35.default(
+        output, a, b, scales_a, sfmx_b, c_b, problem_sizes, expert_offsets, workspace
+    )
+
+
+def nvfp4_woq_bf16_grouped_mm_xe35(
+    output: torch.Tensor,
+    a: torch.Tensor,
+    b: torch.Tensor,
+    sfmx_b: torch.Tensor,
+    c_b: torch.Tensor,
+    problem_sizes: torch.Tensor,
+    expert_offsets: torch.Tensor,
+    workspace: torch.Tensor,
+) -> None:
+    """NVFP4 weight-only-quantized BF16 grouped GEMM (Xe3P / CRI only).
+
+    Activations remain BF16. Packed E2M1 weights are converted and multiplied
+    by their reconstructed per-16 BF16 scale inside the mainloop, then consumed
+    by BF16 DPAS with FP32 accumulation.
+
+    Args:
+        output: (sum_m, N) float32, ragged over experts.
+        a: (sum_m, K) bfloat16 activations.
+        b: (E, N, K/2) uint8 packed E2M1 weights.
+        sfmx_b: (E, K/32, N) uint8 prepared exponent component.
+        c_b: (E, N, K/16) bfloat16 prepared multiplier component.
+        problem_sizes: (E, 3) int32 per-expert (M, N, K).
+        expert_offsets: (E,) int32 cumulative row starts.
+        workspace: uint8 scratch for the grouped GEMM.
+    """
+    from sgl_kernel import is_xe3_arch
+
+    assert (
+        is_xe3_arch()
+    ), "nvfp4_woq_bf16_grouped_mm_xe35 is only supported on CRI (Xe3P) devices"
+    torch.ops.sgl_kernel.nvfp4_woq_bf16_grouped_mm_xe35.default(
+        output, a, b, sfmx_b, c_b, problem_sizes, expert_offsets, workspace
+    )
diff --git a/python/sgl_kernel/nvfp4_moe.py b/python/sgl_kernel/nvfp4_moe.py
new file mode 100644
index 0000000000000000000000000000000000000000..17e2784990989d9b0451ca281468d3fa5776f912
--- /dev/null
+++ b/python/sgl_kernel/nvfp4_moe.py
@@ -0,0 +1,252 @@
+from typing import Optional, Tuple
+
+import torch
+from sgl_kernel.elementwise import silu_and_mul
+from sgl_kernel.gemm import sgl_per_token_group_quant_8bit
+from sgl_kernel.moe import apply_shuffle_mul_sum, prepare_moe_input, scatter_tokens_to_experts
+from sgl_kernel import nvfp4
+from sgl_kernel.nvfp4 import nvfp4_woq_bf16_grouped_mm_xe35, nvfp4_woq_mxfp8_scaled_grouped_mm_xe35
+
+_FP8_E4M3_MIN = -448.0
+_FP8_E4M3_MAX = 448.0
+_MXFP8_BLOCK_SIZE = 32
+
+def _nvfp4_woq_compute_mode_xe35(mode: str = "auto") -> str:
+    mode = mode.strip().lower()
+    if mode not in ("auto", "mxfp8", "bf16"):
+        raise ValueError(
+            "compute_mode must be 'auto', 'mxfp8', or 'bf16', "
+            f"got {mode!r}"
+        )
+    return "bf16" if mode == "auto" else mode
+
+
+def _per_token_group_quant_mxfp8_xe35(x: torch.Tensor, group_size: int = _MXFP8_BLOCK_SIZE):
+    """MXFP8 per-token group quant. Returns (x_q float8_e4m3fn, x_s uint8 UE8M0).
+
+    Uses v1 (enable_v2=False): v2 does not support row-major UE8M0 output.
+    """
+    assert x.shape[-1] % group_size == 0
+    out_q = torch.empty(x.shape, device=x.device, dtype=torch.float8_e4m3fn)
+    out_s_shape = (*x.shape[:-1], x.shape[-1] // group_size)
+    out_s = torch.empty(out_s_shape, device=x.device, dtype=torch.uint8)
+    sgl_per_token_group_quant_8bit(
+        x,
+        out_q,
+        out_s,
+        group_size,
+        1e-10,
+        _FP8_E4M3_MIN,
+        _FP8_E4M3_MAX,
+        True,  # scale_ue8m0
+        False,
+        None,
+        False,  # enable_v2 (v1 supports row-major UE8M0; v2 does not)
+    )
+    return out_q, out_s
+
+
+def nvfp4_woq_prepare_weights_xe35(
+    w1_scale: torch.Tensor,
+    w1_gs: torch.Tensor,
+    w2_scale: torch.Tensor,
+    w2_gs: torch.Tensor,
+) -> dict:
+    """One-time scale prep for :func:`cutlass_fused_experts_nvfp4_woq_xe35`.
+
+    Call once when the checkpoint is loaded and keep the result. ``w1_gs`` and
+    ``w2_gs`` are the FP32 checkpoint global scales used to quantize the block
+    scales: dequantization multiplies by their reciprocals. This function
+    converts them to the dequant multipliers required by ``nvfp4_woq_prep_xe35``.
+    ``w1_gs`` accepts one shared scale per expert or separate ``(gate, up)``
+    scales in shape ``(E, 2)``. ``w2_gs`` accepts one scale per expert.
+    The 4-bit payloads are used as-is.
+    """
+
+    num_experts = w1_scale.size(0)
+    if w1_gs.dim() == 2 and w1_gs.shape == (num_experts, 2):
+        assert (
+            w1_scale.size(1) % 2 == 0
+        ), "w1_scale output dimension must be even for separate gate/up scales"
+        split_n = w1_scale.size(1) // 2
+        gate_c, gate_sfmx = nvfp4.nvfp4_woq_prep_xe35(
+            w1_scale[:, :split_n].contiguous(),
+            w1_gs[:, 0].reciprocal().contiguous(),
+        )
+        up_c, up_sfmx = nvfp4.nvfp4_woq_prep_xe35(
+            w1_scale[:, split_n:].contiguous(),
+            w1_gs[:, 1].reciprocal().contiguous(),
+        )
+        w1_c = torch.cat((gate_c, up_c), dim=1)
+        w1_sfmx = torch.cat((gate_sfmx, up_sfmx), dim=2)
+    else:
+        assert w1_gs.shape in (
+            (num_experts,),
+            (num_experts, 1),
+        ), f"w1_gs must be (E,), (E, 1), or (E, 2), got {tuple(w1_gs.shape)}"
+        w1_c, w1_sfmx = nvfp4.nvfp4_woq_prep_xe35(
+            w1_scale, w1_gs.reshape(num_experts).reciprocal().contiguous()
+        )
+
+    w2_num_experts = w2_scale.size(0)
+    assert w2_gs.shape in (
+        (w2_num_experts,),
+        (w2_num_experts, 1),
+    ), f"w2_gs must be (E,) or (E, 1), got {tuple(w2_gs.shape)}"
+    w2_c, w2_sfmx = nvfp4.nvfp4_woq_prep_xe35(
+        w2_scale, w2_gs.reshape(w2_num_experts).reciprocal().contiguous()
+    )
+    return {"w1_c": w1_c, "w1_sfmx": w1_sfmx, "w2_c": w2_c, "w2_sfmx": w2_sfmx}
+
+
+def cutlass_fused_experts_nvfp4_woq_xe35(
+    a: torch.Tensor,
+    w1_q: torch.Tensor,
+    w2_q: torch.Tensor,
+    prepared: dict,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    output: Optional[torch.Tensor] = None,
+    workspace: Optional[torch.Tensor] = None,
+    compute_mode: str = "auto",
+) -> torch.Tensor:
+    """Fused MoE with NVFP4 weights and MXFP8 or BF16 computation.
+
+    The weights stay 4-bit in memory. Auto mode uses BF16 computation.
+    The explicit ``compute_mode`` argument selects ``auto``, ``mxfp8``, or ``bf16``.
+    For MXFP8, each 32-wide MMA-K slice is converted immediately before BDPAS.
+
+    Args:
+        a: (M, K) bfloat16 activations. FP16 is unsupported because neither
+            compute path preserves FP16 activation precision.
+        w1_q: (E, 2N, K/2) uint8 packed E2M1 gate+up weights.
+        w2_q: (E, K, N/2) uint8 packed E2M1 down weights.
+        prepared: result of :func:`nvfp4_woq_prepare_weights_xe35`.
+        topk_weights, topk_ids: routing results.
+        output: optional (M, K) output buffer.
+        workspace: optional uint8 scratch for the grouped GEMMs.
+        compute_mode: computation precision; ``auto`` (default) uses BF16.
+
+    Returns:
+        (M, K) tensor in ``a.dtype``.
+    """
+
+    assert topk_weights.shape == topk_ids.shape, "topk shape mismatch"
+    assert (
+        w1_q.dtype == torch.uint8 and w2_q.dtype == torch.uint8
+    ), "weights must be packed E2M1 uint8"
+    assert w1_q.dim() == 3 and w2_q.dim() == 3, "weights must be 3D (E, N, K/2)"
+    assert w1_q.shape[0] == w2_q.shape[0], "expert count mismatch w1/w2"
+    if a.dtype != torch.bfloat16:
+        raise TypeError(
+            "NVFP4 WoQ fused experts requires BF16 activations; "
+            f"got {a.dtype}. FP16 activation precision is unsupported."
+        )
+    out_dtype = a.dtype
+    num_experts = w1_q.size(0)
+    m = a.size(0)
+    k = a.size(1)
+    n = w2_q.size(2) * 2  # w2_q is (E, k, n/2)
+    topk = topk_ids.size(1)
+    device = a.device
+    compute_mode = _nvfp4_woq_compute_mode_xe35(compute_mode)
+
+    assert (
+        w1_q.size(2) * 2 == k
+    ), f"w1_q inner dim must be K/2={k // 2}, got {w1_q.size(2)}"
+    assert w2_q.size(1) == k, f"w2_q must have K={k} rows, got {w2_q.size(1)}"
+    assert w1_q.size(1) == 2 * n, f"w1_q must have 2N={2 * n} rows, got {w1_q.size(1)}"
+
+    topk_ids = topk_ids.to(device=device, dtype=torch.int32).contiguous()
+    a_map = torch.empty((topk_ids.numel(),), dtype=torch.int32, device=device)
+    c_map = torch.empty((topk_ids.numel(),), dtype=torch.int32, device=device)
+    expert_counts = torch.zeros(num_experts, dtype=torch.int32, device=device)
+    problem_sizes1 = torch.zeros((num_experts, 3), dtype=torch.int32, device=device)
+    problem_sizes2 = torch.zeros((num_experts, 3), dtype=torch.int32, device=device)
+    prepare_moe_input(
+        topk_ids,
+        expert_counts,
+        problem_sizes1,
+        problem_sizes2,
+        a_map,
+        c_map,
+        num_experts,
+        n,
+        k,
+    )
+    expert_starts = torch.zeros(num_experts, dtype=torch.int32, device=device)
+    if num_experts > 1:
+        expert_starts[1:] = torch.cumsum(expert_counts[:-1], dim=0).to(torch.int32)
+
+    if workspace is None:
+        workspace = torch.zeros((64 * 1024 * 1024,), dtype=torch.uint8, device=device)
+
+    c1 = torch.zeros((m * topk, n * 2), dtype=torch.float32, device=device)
+    c2 = torch.zeros((m * topk, k), dtype=torch.float32, device=device)
+    if compute_mode == "bf16":
+        # Both GEMMs consume BF16 directly.
+        rep_a = torch.empty((m * topk, k), dtype=torch.bfloat16, device=device)
+        scatter_tokens_to_experts(a, c_map, rep_a)
+        nvfp4_woq_bf16_grouped_mm_xe35(
+            c1,
+            rep_a,
+            w1_q,
+            prepared["w1_sfmx"],
+            prepared["w1_c"],
+            problem_sizes1,
+            expert_starts,
+            workspace,
+        )
+
+        intermediate = torch.empty((m * topk, n), dtype=torch.bfloat16, device=device)
+        silu_and_mul(c1.to(torch.bfloat16), intermediate)
+        nvfp4_woq_bf16_grouped_mm_xe35(
+            c2,
+            intermediate,
+            w2_q,
+            prepared["w2_sfmx"],
+            prepared["w2_c"],
+            problem_sizes2,
+            expert_starts,
+            workspace,
+        )
+    else:
+        # XPU scatter doesn't support fp8; scatter in a.dtype then quantize.
+        rep_a = torch.empty((m * topk, k), dtype=a.dtype, device=device)
+        scatter_tokens_to_experts(a, c_map, rep_a)
+        rep_a_q, rep_a_s = _per_token_group_quant_mxfp8_xe35(
+            rep_a, group_size=_MXFP8_BLOCK_SIZE
+        )
+        nvfp4_woq_mxfp8_scaled_grouped_mm_xe35(
+            c1,
+            rep_a_q,
+            w1_q,
+            rep_a_s,
+            prepared["w1_sfmx"],
+            prepared["w1_c"],
+            problem_sizes1,
+            expert_starts,
+            workspace,
+        )
+
+        intermediate = torch.empty((m * topk, n), dtype=out_dtype, device=device)
+        silu_and_mul(c1.to(out_dtype), intermediate)
+        inter_q, inter_s = _per_token_group_quant_mxfp8_xe35(
+            intermediate, group_size=_MXFP8_BLOCK_SIZE
+        )
+        nvfp4_woq_mxfp8_scaled_grouped_mm_xe35(
+            c2,
+            inter_q,
+            w2_q,
+            inter_s,
+            prepared["w2_sfmx"],
+            prepared["w2_c"],
+            problem_sizes2,
+            expert_starts,
+            workspace,
+        )
+
+    if output is None:
+        output = torch.empty((m, k), dtype=out_dtype, device=device)
+    apply_shuffle_mul_sum(c2.to(out_dtype), output, c_map, topk_weights.to(out_dtype))
+    return output
