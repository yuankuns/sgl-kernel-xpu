diff --git a/src/sycl/xe35/FusedQKNormRope.cpp b/src/sycl/xe35/FusedQKNormRope.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2cbb18d14591de346d449bf528a1b269e8b1aa16
--- /dev/null
+++ b/src/sycl/xe35/FusedQKNormRope.cpp
@@ -0,0 +1,408 @@
+#include <ATen/ATen.h>
+#include <ATen/OpMathType.h>
+#include <ATen/Parallel.h>
+#include <c10/util/Float8_e4m3fn.h>
+#include <c10/xpu/XPUStream.h>
+#include <torch/all.h>
+
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <sycl/sycl.hpp>
+#include <vector>
+
+#include "FusedQKNormRopeKernel.h"
+#include "../MemoryAccess.h"
+#include "../Norm.h"
+#include "sgl_kernel_export.h"
+#include "../SYCLHelpers.h"
+#include "../Utils.h"
+#include "cutlass/float8.h"
+
+// TODO: Remove this when sycl float8 is supported
+using cutlass::float_e4m3_t;
+
+namespace at::native::xpu {
+
+template <typename T>
+inline T divUp_xe35(T m, T n) {
+  return (m + n - 1) / n;
+}
+
+// Sub-group reduction for sum
+template <typename T>
+inline T subGroupReduceSum_xe35(T val, const sycl::sub_group& sg) {
+  for (int offset = sg.get_max_local_range()[0] / 2; offset > 0; offset /= 2) {
+    val += sycl::shift_group_left(sg, val, offset);
+  }
+  return val;
+}
+
+// SYCL Kernel_xe35 for Fused QK Norm and RoPE
+template <int head_dim, bool interleave, typename scalar_t, bool UseTable>
+struct FusedQKNormRopeKernel_xe35 {
+  scalar_t* qkv;
+  int num_heads_q;
+  int num_heads_k;
+  int num_heads_v;
+  float eps;
+  const scalar_t* q_weight;
+  const scalar_t* k_weight;
+  float base;
+  const int* position_ids;
+  int num_tokens;
+  float factor;
+  float low;
+  float high;
+  float attention_factor;
+  int rotary_dim;
+  QKRopeFrequencyStorage_xe35<head_dim, UseTable> frequencies;
+
+  void operator()(sycl::nd_item<1> item) const {
+    // Always use float for accumulation, regardless of scalar_t
+    using accscalar_t = float;
+
+    const int sg_size = item.get_sub_group().get_max_local_range()[0];
+    const int warpsPerBlock = item.get_local_range(0) / sg_size;
+    const int warpId = item.get_local_id(0) / sg_size;
+    const int laneId = item.get_local_id(0) % sg_size;
+
+    const int globalWarpIdx = item.get_group(0) * warpsPerBlock + warpId;
+    const int total_qk_heads = num_heads_q + num_heads_k;
+
+    const int tokenIdx = globalWarpIdx / total_qk_heads;
+    const int localHeadIdx = globalWarpIdx % total_qk_heads;
+
+    if (tokenIdx >= num_tokens) return;
+
+    const bool isQ = localHeadIdx < num_heads_q;
+    const int headIdx = isQ ? localHeadIdx : localHeadIdx - num_heads_q;
+    const int num_heads = num_heads_q + num_heads_k + num_heads_v;
+
+    constexpr int numElemsPerThread = head_dim / 32;
+    accscalar_t elements[numElemsPerThread];
+
+    int offsetWarp;
+    if (isQ) {
+      offsetWarp = tokenIdx * num_heads * head_dim + headIdx * head_dim;
+    } else {
+      offsetWarp = tokenIdx * num_heads * head_dim + num_heads_q * head_dim + headIdx * head_dim;
+    }
+    int offsetThread = offsetWarp + laneId * numElemsPerThread;
+
+    // Load data and compute sum of squares for RMSNorm
+    accscalar_t sumOfSquares = 0.0f;
+    for (int i = 0; i < numElemsPerThread; i++) {
+      elements[i] = static_cast<accscalar_t>(qkv[offsetThread + i]);
+      sumOfSquares += elements[i] * elements[i];
+    }
+
+    // Reduce sum across sub-group (warp)
+    auto sg = item.get_sub_group();
+    sumOfSquares = sycl::reduce_over_group(sg, sumOfSquares, sycl::plus<accscalar_t>{});
+
+    // Compute RMS normalization factor
+    float rms_rcp = sycl::rsqrt(sumOfSquares / static_cast<float>(head_dim) + eps);
+
+    // Normalize elements
+    const scalar_t* weight_ptr = isQ ? q_weight : k_weight;
+    for (int i = 0; i < numElemsPerThread; i++) {
+      int dim = laneId * numElemsPerThread + i;
+      accscalar_t weight = static_cast<accscalar_t>(weight_ptr[dim]);
+      elements[i] *= rms_rcp * weight;
+    }
+
+    // Apply RoPE to normalized elements
+    accscalar_t elements2[numElemsPerThread];
+    accscalar_t cos_vals[numElemsPerThread];
+    accscalar_t sin_vals[numElemsPerThread];
+    float pos_id = static_cast<float>(position_ids[tokenIdx]);
+    const int rotary_lanes = rotary_dim / numElemsPerThread;
+    const bool applyRotary = (laneId < rotary_lanes);
+
+    if (applyRotary) {
+      if constexpr (interleave) {
+        // Interleave mode
+        for (int i = 0; i < numElemsPerThread; i++) {
+          elements2[i] = (i % 2 == 0) ? -elements[i + 1] : elements[i - 1];
+
+          int dim_idx = laneId * numElemsPerThread + i;
+          int half_dim = dim_idx / 2;
+          float freq = frequencies[half_dim];
+          float theta = pos_id * freq;
+          sin_vals[i] = sycl::sin(theta);
+          cos_vals[i] = sycl::cos(theta);
+        }
+      } else {
+        // Neox style - use XOR shuffle like CUDA
+        sycl::group_barrier(sg);
+        const int half_rotary_lanes = rotary_lanes / 2;
+
+        for (int i = 0; i < numElemsPerThread; i++) {
+          // XOR shuffle to exchange between first and second half
+          elements2[i] = sycl::permute_group_by_xor(sg, elements[i], half_rotary_lanes);
+          if (laneId < half_rotary_lanes) {
+            elements2[i] = -elements2[i];
+          }
+
+          int dim_idx = laneId * numElemsPerThread + i;
+          dim_idx = (dim_idx * 2) % rotary_dim;
+          int half_dim = dim_idx / 2;
+          float freq = frequencies[half_dim];
+          float theta = pos_id * freq;
+          sin_vals[i] = sycl::sin(theta);
+          cos_vals[i] = sycl::cos(theta);
+        }
+        sycl::group_barrier(sg);
+      }
+
+      // Apply rotation with attention_factor
+      for (int i = 0; i < numElemsPerThread; i++) {
+        elements[i] = (elements[i] * cos_vals[i] + elements2[i] * sin_vals[i]) * attention_factor;
+      }
+    }
+
+    // Store results
+    for (int i = 0; i < numElemsPerThread; i++) {
+      qkv[offsetThread + i] = static_cast<scalar_t>(elements[i]);
+    }
+  }
+};
+template <int head_dim, bool interleave, typename scalar_t>
+void launchFusedQKNormRopeImpl_xe35(
+    void* qkv,
+    int num_tokens,
+    int num_heads_q,
+    int num_heads_k,
+    int num_heads_v,
+    float eps,
+    const void* q_weight,
+    const void* k_weight,
+    float base,
+    const int* position_ids,
+    float factor,
+    float low,
+    float high,
+    float attention_factor,
+    int rotary_dim,
+    sycl::queue& q) {
+  constexpr int blockSize = 256;
+  const int warpsPerBlock = blockSize / 32;
+  const int totalQKHeads = num_heads_q + num_heads_k;
+  const int totalWarps = num_tokens * totalQKHeads;
+  const int gridSize = divUp_xe35(totalWarps, warpsPerBlock);
+
+  const float* table = qk_rope_cached_frequencies_xe35(q, base, rotary_dim, factor, low, high);
+  auto submit = [&]<bool UseTable>() {
+    FusedQKNormRopeKernel_xe35<head_dim, interleave, scalar_t, UseTable> kernel{
+        static_cast<scalar_t*>(qkv),
+        num_heads_q,
+        num_heads_k,
+        num_heads_v,
+        eps,
+        static_cast<const scalar_t*>(q_weight),
+        static_cast<const scalar_t*>(k_weight),
+        base,
+        position_ids,
+        num_tokens,
+        factor,
+        low,
+        high,
+        attention_factor,
+        rotary_dim,
+        qk_rope_frequency_storage_xe35<head_dim, UseTable>(table, base, rotary_dim, factor, low, high)};
+
+    sycl_kernel_submit(sycl::range<1>(gridSize * blockSize), sycl::range<1>(blockSize), q, kernel);
+  };
+  if (table)
+    submit.template operator()<true>();
+  else
+    submit.template operator()<false>();
+}
+
+SGL_KERNEL_EXPORT void fused_qk_norm_rope_xe35(
+    torch::Tensor& qkv,
+    int64_t num_heads_q,
+    int64_t num_heads_k,
+    int64_t num_heads_v,
+    int64_t head_dim,
+    double eps,
+    torch::Tensor& q_weight,
+    torch::Tensor& k_weight,
+    double base,
+    bool is_neox,
+    torch::Tensor& position_ids,
+    double factor,
+    double low,
+    double high,
+    double attention_factor,
+    int64_t rotary_dim) {
+  // Input validation
+  TORCH_CHECK(qkv.dim() == 2, "QKV tensor must be 2D: [num_tokens, (num_heads_q+num_heads_k+num_heads_v)*head_dim]");
+  TORCH_CHECK(position_ids.dim() == 1, "Position IDs must be 1D: [num_tokens]");
+  TORCH_CHECK(q_weight.dim() == 1, "Query weights must be 1D: [head_dim]");
+  TORCH_CHECK(k_weight.dim() == 1, "Key weights must be 1D: [head_dim]");
+  TORCH_CHECK(q_weight.size(0) == head_dim, "Query weights size must match head dimension");
+  TORCH_CHECK(k_weight.size(0) == head_dim, "Key weights size must match head dimension");
+  TORCH_CHECK(rotary_dim % (head_dim / 32) == 0, "rotary_dim must be divisible by numElemsPerThread");
+
+  if (is_neox) {
+    int64_t half_rotary_lanes = rotary_dim / (head_dim / 32) / 2;
+    TORCH_CHECK(
+        half_rotary_lanes >= 1 && (half_rotary_lanes & (half_rotary_lanes - 1)) == 0,
+        "half_rotary_lanes must be a power of 2 for neox style, got ",
+        half_rotary_lanes);
+  }
+
+  CHECK_DEVICE(qkv);
+  CHECK_CONTIGUOUS(qkv);
+  CHECK_DEVICE(position_ids);
+  CHECK_CONTIGUOUS(position_ids);
+  TORCH_CHECK(
+      position_ids.scalar_type() == at::ScalarType::Int,
+      "position_ids must have dtype int32 (at::kInt); got ",
+      position_ids.scalar_type());
+  CHECK_DEVICE(q_weight);
+  CHECK_CONTIGUOUS(q_weight);
+  CHECK_DEVICE(k_weight);
+  CHECK_CONTIGUOUS(k_weight);
+
+  int64_t num_tokens = qkv.size(0);
+  TORCH_CHECK(position_ids.size(0) == num_tokens, "Number of tokens in position_ids must match QKV");
+
+  int64_t total_heads = num_heads_q + num_heads_k + num_heads_v;
+  TORCH_CHECK(
+      qkv.size(1) == total_heads * head_dim, "QKV tensor size must match total number of heads and head dimension");
+
+  auto queue = dpcppGetCurrentQueue();
+  bool interleave = !is_neox;
+
+  // The Xe35 wide-access kernel is tuned for the two 16-bit types. Preserve
+  // the existing implementation for FP8 and for small shapes where its finer
+  // one-head-per-subgroup decomposition has better occupancy.
+  const int wide_lanes_per_head = static_cast<int>(head_dim) / (32 / static_cast<int>(qkv.element_size()));
+  const bool use_xe35_wide =
+      qkv.element_size() == 2 && !qk_norm_rope_kernel_xe35::prefer_baseline_xe35(
+                                     num_tokens, static_cast<int>(num_heads_q + num_heads_k), wide_lanes_per_head);
+
+// Maps at::ScalarType to the corresponding SYCL/cutlass C++ type (scalar_t)
+// and immediately invokes the callable passed as the variadic argument.
+// Float8_e4m3fn uses the cutlass type because native SYCL float8 is not yet
+// supported; Half and BFloat16 use their respective SYCL types.
+#define SYCL_DISPATCH_QK_FLOATING_TYPES_XE35(SCALAR_TYPE, KERNEL_NAME, ...)                 \
+  [&]() {                                                                           \
+    switch (SCALAR_TYPE) {                                                          \
+      case at::ScalarType::Half: {                                                  \
+        using scalar_t = sycl::half;                                                \
+        __VA_ARGS__();                                                              \
+        break;                                                                      \
+      }                                                                             \
+      case at::ScalarType::BFloat16: {                                              \
+        using scalar_t = sycl::ext::oneapi::bfloat16;                               \
+        __VA_ARGS__();                                                              \
+        break;                                                                      \
+      }                                                                             \
+      case at::ScalarType::Float8_e4m3fn: {                                         \
+        using scalar_t = float_e4m3_t;                                              \
+        __VA_ARGS__();                                                              \
+        break;                                                                      \
+      }                                                                             \
+      default:                                                                      \
+        TORCH_CHECK(false, "Unsupported dtype for " KERNEL_NAME ": ", SCALAR_TYPE); \
+    }                                                                               \
+  }()
+
+// The lambda is wrapped in an extra () so that commas in the template argument
+// list <HD, IL, scalar_t> are hidden from the preprocessor's argument splitter.
+#define LAUNCH_KERNEL(HD, IL)                                                    \
+  SYCL_DISPATCH_QK_FLOATING_TYPES_XE35(qkv.scalar_type(), "fused_qk_norm_rope", ([&]() { \
+                                 launchFusedQKNormRopeImpl_xe35<HD, IL, scalar_t>(    \
+                                     qkv.data_ptr(),                             \
+                                     static_cast<int>(num_tokens),               \
+                                     static_cast<int>(num_heads_q),              \
+                                     static_cast<int>(num_heads_k),              \
+                                     static_cast<int>(num_heads_v),              \
+                                     static_cast<float>(eps),                    \
+                                     q_weight.data_ptr(),                        \
+                                     k_weight.data_ptr(),                        \
+                                     static_cast<float>(base),                   \
+                                     position_ids.data_ptr<int>(),               \
+                                     static_cast<float>(factor),                 \
+                                     static_cast<float>(low),                    \
+                                     static_cast<float>(high),                   \
+                                     static_cast<float>(attention_factor),       \
+                                     static_cast<int>(rotary_dim),               \
+                                     queue);                                     \
+                               }))
+
+#define LAUNCH_XE35_KERNEL(HD, IL)                                                      \
+  SYCL_DISPATCH_QK_FLOATING_TYPES_XE35(qkv.scalar_type(), "fused_qk_norm_rope", ([&]() {        \
+                                 qk_norm_rope_kernel_xe35::launch_xe35<scalar_t, HD, IL>(     \
+                                     static_cast<scalar_t*>(qkv.data_ptr()),            \
+                                     static_cast<int>(num_tokens),                      \
+                                     static_cast<int>(num_heads_q),                     \
+                                     static_cast<int>(num_heads_k),                     \
+                                     static_cast<int>(num_heads_v),                     \
+                                     static_cast<float>(eps),                           \
+                                     static_cast<const scalar_t*>(q_weight.data_ptr()), \
+                                     static_cast<const scalar_t*>(k_weight.data_ptr()), \
+                                     static_cast<float>(base),                          \
+                                     position_ids.data_ptr<int>(),                      \
+                                     static_cast<float>(factor),                        \
+                                     static_cast<float>(low),                           \
+                                     static_cast<float>(high),                          \
+                                     static_cast<float>(attention_factor),              \
+                                     static_cast<int>(rotary_dim),                      \
+                                     queue);                                            \
+                               }))
+
+  switch (head_dim) {
+    case 64:
+      if (interleave) {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(64, true);
+        else
+          LAUNCH_KERNEL(64, true);
+      } else {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(64, false);
+        else
+          LAUNCH_KERNEL(64, false);
+      }
+      break;
+    case 128:
+      if (interleave) {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(128, true);
+        else
+          LAUNCH_KERNEL(128, true);
+      } else {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(128, false);
+        else
+          LAUNCH_KERNEL(128, false);
+      }
+      break;
+    case 256:
+      if (interleave) {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(256, true);
+        else
+          LAUNCH_KERNEL(256, true);
+      } else {
+        if (use_xe35_wide)
+          LAUNCH_XE35_KERNEL(256, false);
+        else
+          LAUNCH_KERNEL(256, false);
+      }
+      break;
+    default:
+      TORCH_CHECK(false, "Unsupported head dimension for fusedQKNormRope: ", head_dim);
+  }
+
+#undef LAUNCH_KERNEL
+#undef LAUNCH_XE35_KERNEL
+#undef SYCL_DISPATCH_QK_FLOATING_TYPES_XE35
+}
+
+}  // namespace at::native::xpu
diff --git a/src/sycl/xe35/FusedQKNormRopeFrequency.h b/src/sycl/xe35/FusedQKNormRopeFrequency.h
new file mode 100644
index 0000000000000000000000000000000000000000..1aa8591d7c73fbe7defa89f1d4d79b521fc3b4f0
--- /dev/null
+++ b/src/sycl/xe35/FusedQKNormRopeFrequency.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <c10/util/Exception.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <memory>
+#include <mutex>
+#include <sycl/sycl.hpp>
+#include <type_traits>
+#include <vector>
+
+namespace at::native::xpu {
+
+template <int HeadDim>
+inline std::array<float, HeadDim / 2>
+qk_rope_frequencies_xe35(float base, int rotary_dim, float factor, float low, float high) {
+  std::array<float, HeadDim / 2> frequencies{};
+  for (int half_dim = 0; half_dim < rotary_dim / 2; ++half_dim) {
+    float frequency = static_cast<float>(std::pow(static_cast<double>(base), -2.0 * half_dim / rotary_dim));
+    if (factor != 1.0f) {
+      const float high_adjusted = std::fabs(low - high) <= 1e-6f ? high + 0.001f : high;
+      const float ramp = std::clamp((2.0f * half_dim - low) / (high_adjusted - low), 0.0f, 1.0f);
+      frequency = (frequency / factor) * (1.0f - ramp) + frequency * ramp;
+    }
+    frequencies[half_dim] = frequency;
+  }
+  return frequencies;
+}
+
+struct QKRopeFrequencyTable_xe35 {
+  sycl::context context;
+  sycl::device device;
+  std::array<float, 4> parameters;
+  int rotary_dim;
+  float* data;
+
+  QKRopeFrequencyTable_xe35(const sycl::queue& queue, std::array<float, 4> parameters, int rotary_dim)
+      : context(queue.get_context()),
+        device(queue.get_device()),
+        parameters(parameters),
+        rotary_dim(rotary_dim),
+        data(sycl::malloc_shared<float>(rotary_dim / 2, device, context)) {
+    TORCH_CHECK(data != nullptr, "Failed to allocate QK RoPE frequency table");
+    const auto values =
+        qk_rope_frequencies_xe35<256>(parameters[0], rotary_dim, parameters[1], parameters[2], parameters[3]);
+    std::copy_n(values.data(), rotary_dim / 2, data);
+  }
+
+  ~QKRopeFrequencyTable_xe35() {
+    sycl::free(data, context);
+  }
+
+  bool matches(const sycl::queue& queue, const std::array<float, 4>& requested, int dim) const {
+    return rotary_dim == dim && parameters == requested && context == queue.get_context() &&
+           device == queue.get_device();
+  }
+};
+
+inline const float*
+qk_rope_cached_frequencies_xe35(const sycl::queue& queue, float base, int rotary_dim, float factor, float low, float high) {
+  if (!queue.get_device().has(sycl::aspect::usm_shared_allocations)) return nullptr;
+  const std::array<float, 4> parameters{base, factor, low, high};
+  static std::mutex mutex;
+  static std::vector<std::shared_ptr<QKRopeFrequencyTable_xe35>> tables;
+  thread_local std::shared_ptr<QKRopeFrequencyTable_xe35> last;
+  if (last && last->matches(queue, parameters, rotary_dim)) return last->data;
+  std::lock_guard<std::mutex> lock(mutex);
+  for (const auto& table : tables) {
+    if (table->matches(queue, parameters, rotary_dim)) {
+      last = table;
+      return table->data;
+    }
+  }
+  auto table = std::make_shared<QKRopeFrequencyTable_xe35>(queue, parameters, rotary_dim);
+  tables.push_back(table);
+  last = table;
+  return table->data;
+}
+
+template <int HeadDim, bool UseTable>
+using QKRopeFrequencyStorage_xe35 = std::conditional_t<UseTable, const float*, std::array<float, HeadDim / 2>>;
+
+template <int HeadDim, bool UseTable>
+inline QKRopeFrequencyStorage_xe35<HeadDim, UseTable>
+qk_rope_frequency_storage_xe35(const float* table, float base, int rotary_dim, float factor, float low, float high) {
+  if constexpr (UseTable)
+    return table;
+  else
+    return qk_rope_frequencies_xe35<HeadDim>(base, rotary_dim, factor, low, high);
+}
+
+}  // namespace at::native::xpu
diff --git a/src/sycl/xe35/FusedQKNormRopeKernel.h b/src/sycl/xe35/FusedQKNormRopeKernel.h
new file mode 100644
index 0000000000000000000000000000000000000000..264aa493b94e7386ce809d8192af6ebc7a6f1428
--- /dev/null
+++ b/src/sycl/xe35/FusedQKNormRopeKernel.h
@@ -0,0 +1,354 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <type_traits>
+
+#include "FusedQKNormRopeFrequency.h"
+#include "../MemoryAccess.h"
+#include "../SYCLHelpers.h"
+#include "../Utils.h"
+
+namespace at::native::xpu::qk_norm_rope_kernel_xe35 {
+
+constexpr int kSubgroupSize = 16;
+constexpr int kBytesPerLane = 32;
+constexpr int kTargetWorkgroup = 128;
+constexpr int kMaxWorkgroup = 256;
+constexpr int kMaxTokensPerWg = 4;
+constexpr int64_t kCacheTrafficBytes = 48ll << 20;
+constexpr int64_t kDramTrafficBytes = 100ll << 20;
+// The first repeatable BF16 128D sparse-row split gain starts at 300 MiB.
+constexpr int64_t kSparseRowSplitBytes = 300ll << 20;
+constexpr int64_t kSparseRowAlignmentBytes = 4ll << 10;
+constexpr int kCacheRoundCap = 9;
+constexpr int kDramRoundCap = 3;
+
+struct LaunchConfig_xe35 {
+  int wg_lanes;
+  int tokens_per_wg;
+  int clusters_per_token;
+  int heads_per_chunk;
+  int chunks_per_token;
+  int rounds;
+  int64_t groups;
+};
+
+inline LaunchConfig_xe35
+make_launch_xe35(int64_t num_tokens, int total_qk_heads, int lanes_per_head_xe35, int wg_lanes, int tokens_per_wg, int chunks) {
+  LaunchConfig_xe35 config{};
+  config.wg_lanes = wg_lanes;
+  config.tokens_per_wg = tokens_per_wg;
+  config.clusters_per_token = std::max(wg_lanes / lanes_per_head_xe35 / tokens_per_wg, 1);
+  config.chunks_per_token = chunks;
+  config.rounds = ((total_qk_heads + chunks - 1) / chunks + config.clusters_per_token - 1) / config.clusters_per_token;
+  config.heads_per_chunk = config.rounds * config.clusters_per_token;
+  config.chunks_per_token = (total_qk_heads + config.heads_per_chunk - 1) / config.heads_per_chunk;
+  config.groups = ((num_tokens + tokens_per_wg - 1) / tokens_per_wg) * config.chunks_per_token;
+  return config;
+}
+
+template <typename scalar_t, int HeadDim, bool Interleave>
+inline LaunchConfig_xe35 choose_launch_xe35(int64_t num_tokens, int total_qk_heads, int lanes_per_head_xe35, int row_heads) {
+  const int64_t slots_per_sg = std::max<int64_t>(kSubgroupSize / lanes_per_head_xe35, 1);
+  const int64_t wave = std::max<int64_t>(dpcppGpuEuCount() * dpcppGpuHWThreadsPerEU(), 1);
+  const int64_t work = num_tokens * total_qk_heads;
+  const int rounds = static_cast<int>(std::max<int64_t>(1, (work + slots_per_sg * wave - 1) / (slots_per_sg * wave)));
+  const int64_t traffic = 2 * work * lanes_per_head_xe35 * kBytesPerLane;
+  if constexpr (Interleave) {
+    // Keep the existing 64D split. Extend it only to measured BF16 128D rows.
+    const bool sparse_row = row_heads >= 2 * total_qk_heads;
+    const bool original_split = lanes_per_head_xe35 == 4 && traffic > kDramTrafficBytes;
+    const int64_t row_bytes = static_cast<int64_t>(row_heads) * HeadDim * sizeof(scalar_t);
+    const bool bf16_128d_split = std::is_same_v<scalar_t, sycl::ext::oneapi::bfloat16> && HeadDim == 128 &&
+                                 row_bytes % kSparseRowAlignmentBytes == 0 && traffic >= kSparseRowSplitBytes;
+    if (sparse_row && (original_split || bf16_128d_split)) {
+      return make_launch_xe35(num_tokens, total_qk_heads, lanes_per_head_xe35, 192, 1, 2);
+    }
+  }
+  const int round_cap = traffic > kDramTrafficBytes    ? kDramRoundCap
+                        : traffic > kCacheTrafficBytes ? kCacheRoundCap
+                                                       : rounds;
+
+  if (rounds > round_cap) {
+    const int cluster_cap = std::max(kMaxWorkgroup / lanes_per_head_xe35, 1);
+    const int clusters = std::min((total_qk_heads + round_cap - 1) / round_cap, cluster_cap);
+    return make_launch_xe35(num_tokens, total_qk_heads, lanes_per_head_xe35, clusters * lanes_per_head_xe35, 1, 1);
+  }
+
+  const int cluster_cap = std::max(kTargetWorkgroup / lanes_per_head_xe35, 1);
+  int clusters = 1;
+  int best_waste = -1;
+  for (int candidate = 1; candidate <= cluster_cap; ++candidate) {
+    const int chunks = (total_qk_heads + rounds * candidate - 1) / (rounds * candidate);
+    const int waste = chunks * rounds * candidate - total_qk_heads;
+    if (best_waste < 0 || waste <= best_waste) {
+      clusters = candidate;
+      best_waste = waste;
+    }
+  }
+
+  int tokens_per_wg = 1;
+  while (tokens_per_wg < kMaxTokensPerWg && clusters * lanes_per_head_xe35 * tokens_per_wg < kSubgroupSize) {
+    tokens_per_wg <<= 1;
+  }
+  const int chunks = (total_qk_heads + rounds * clusters - 1) / (rounds * clusters);
+  return make_launch_xe35(
+      num_tokens, total_qk_heads, lanes_per_head_xe35, clusters * lanes_per_head_xe35 * tokens_per_wg, tokens_per_wg, chunks);
+}
+
+inline int partner_lanes_for_xe35(int rotary_dim, int elements_per_lane) {
+  const int half = rotary_dim / 2;
+  if (half <= 0 || half % elements_per_lane != 0) return 0;
+  const int lanes = half / elements_per_lane;
+  return (lanes & (lanes - 1)) == 0 ? lanes : 0;
+}
+
+template <typename scalar_t>
+inline int lanes_per_head_xe35(int head_dim) {
+  const int wide = kBytesPerLane / sizeof(scalar_t);
+  return head_dim / std::min(head_dim, wide);
+}
+
+inline bool prefer_baseline_xe35(int64_t num_tokens, int total_qk_heads, int lanes_per_head_xe35) {
+  const int64_t slots_per_sg = std::max<int64_t>(kSubgroupSize / lanes_per_head_xe35, 1);
+  const int64_t subgroups = (num_tokens * total_qk_heads + slots_per_sg - 1) / slots_per_sg;
+  const int64_t wave = std::max<int64_t>(dpcppGpuEuCount() * dpcppGpuHWThreadsPerEU(), 1);
+  return subgroups * 4 < wave;
+}
+
+template <typename scalar_t, int HeadDim, bool Interleave, bool UseTable>
+struct Kernel_xe35 {
+  static constexpr int kElementsPerLane = kBytesPerLane / sizeof(scalar_t);
+  static constexpr int kLanesPerHead = HeadDim / kElementsPerLane;
+  using vec_t = aligned_vector_loop<scalar_t, kElementsPerLane>;
+
+  static_assert(HeadDim % kElementsPerLane == 0);
+  static_assert(kSubgroupSize % kLanesPerHead == 0);
+
+  scalar_t* qkv;
+  const scalar_t* q_weight;
+  const scalar_t* k_weight;
+  const int* position_ids;
+  float eps;
+  float base;
+  float factor;
+  float low;
+  float high;
+  float attention_factor;
+  int rotary_dim;
+  int num_tokens;
+  int num_heads_q;
+  int num_heads;
+  int total_qk_heads;
+  LaunchConfig_xe35 config;
+  int partner_lanes;
+  QKRopeFrequencyStorage_xe35<HeadDim, UseTable> frequencies;
+
+  template <int Delta>
+  void rotate_neox(
+      const sycl::sub_group& sg,
+      const float (&values)[kElementsPerLane],
+      const float (&cos_values)[kElementsPerLane],
+      const float (&sin_values)[kElementsPerLane],
+      int first_dim,
+      int half_rotary,
+      int rotary_count,
+      vec_t& output) const {
+#pragma unroll
+    for (int i = 0; i < kElementsPerLane; ++i) {
+      const float peer = sycl::permute_group_by_xor(sg, values[i], static_cast<uint32_t>(Delta));
+      const float rotated_peer = first_dim + i < half_rotary ? -peer : peer;
+      output[i] = static_cast<scalar_t>(
+          i < rotary_count ? (values[i] * cos_values[i] + rotated_peer * sin_values[i]) * attention_factor : values[i]);
+    }
+  }
+
+  [[sycl::reqd_sub_group_size(kSubgroupSize)]] void operator()(sycl::nd_item<1> item) const {
+    const auto sg = item.get_sub_group();
+    const int local_id = static_cast<int>(item.get_local_id(0));
+    const int group_id = static_cast<int>(item.get_group(0));
+    const int token_group = group_id / config.chunks_per_token;
+    const int chunk = group_id - token_group * config.chunks_per_token;
+    const int cluster = local_id / kLanesPerHead;
+    const int first_dim = (local_id - cluster * kLanesPerHead) * kElementsPerLane;
+    const int local_token = cluster / config.clusters_per_token;
+    const int slot = cluster - local_token * config.clusters_per_token;
+    const int half_rotary = rotary_dim / 2;
+    const int token_raw = token_group * config.tokens_per_wg + local_token;
+    const bool token_live = token_raw < num_tokens;
+    const int token = token_live ? token_raw : num_tokens - 1;
+
+    auto local =
+        sycl::ext::oneapi::group_local_memory_for_overwrite<float[kMaxTokensPerWg * 2 * HeadDim]>(item.get_group());
+    float* table = *local;
+    for (int index = local_id; index < config.tokens_per_wg * HeadDim; index += config.wg_lanes) {
+      const int local_table_token = index / HeadDim;
+      const int dim = index - local_table_token * HeadDim;
+      const int table_token = std::min(token_group * config.tokens_per_wg + local_table_token, num_tokens - 1);
+      const int half_dim = Interleave ? dim / 2 : (dim < half_rotary ? dim : dim - half_rotary);
+      const float theta =
+          dim < rotary_dim ? static_cast<float>(position_ids[table_token]) * frequencies[half_dim] : 0.0f;
+      table[local_table_token * 2 * HeadDim + dim] = sycl::sin(theta);
+      table[local_table_token * 2 * HeadDim + HeadDim + dim] = sycl::cos(theta);
+    }
+    sycl::group_barrier(item.get_group());
+
+    float sin_values[kElementsPerLane];
+    float cos_values[kElementsPerLane];
+    const float* token_table = table + local_token * 2 * HeadDim;
+#pragma unroll
+    for (int i = 0; i < kElementsPerLane; ++i) {
+      sin_values[i] = token_table[first_dim + i];
+      cos_values[i] = token_table[HeadDim + first_dim + i];
+    }
+
+    const int rotary_count = rotary_dim - first_dim;
+    const int64_t token_offset = static_cast<int64_t>(token) * num_heads * HeadDim;
+    const int base_head = chunk * config.heads_per_chunk;
+    const int heads_here = std::min(total_qk_heads - base_head, config.heads_per_chunk);
+    const int rounds = (heads_here + config.clusters_per_token - 1) / config.clusters_per_token;
+    auto head_for = [&](int round) {
+      return std::min(base_head + round * config.clusters_per_token + slot, base_head + heads_here - 1);
+    };
+    auto row_for = [&](int head) { return qkv + token_offset + static_cast<int64_t>(head) * HeadDim; };
+
+    float weights[kElementsPerLane];
+    bool weight_is_q = false;
+    bool weight_valid = false;
+    for (int round = 0; round < rounds; ++round) {
+      const int head = head_for(round);
+      const vec_t input = *reinterpret_cast<const vec_t*>(row_for(head) + first_dim);
+      const bool store = token_live && base_head + round * config.clusters_per_token + slot < base_head + heads_here;
+
+      float square_sum = 0.0f;
+#pragma unroll
+      for (int i = 0; i < kElementsPerLane; ++i) {
+        const float value = static_cast<float>(input[i]);
+        square_sum += value * value;
+      }
+#pragma unroll
+      for (int step = 1; step < kLanesPerHead; step <<= 1) {
+        square_sum += sycl::permute_group_by_xor(sg, square_sum, static_cast<uint32_t>(step));
+      }
+
+      const float reciprocal_rms = sycl::rsqrt(square_sum / static_cast<float>(HeadDim) + eps);
+      const bool is_q = head < num_heads_q;
+      if (!weight_valid || is_q != weight_is_q) {
+        const vec_t weight = *reinterpret_cast<const vec_t*>((is_q ? q_weight : k_weight) + first_dim);
+#pragma unroll
+        for (int i = 0; i < kElementsPerLane; ++i)
+          weights[i] = static_cast<float>(weight[i]);
+        weight_is_q = is_q;
+        weight_valid = true;
+      }
+
+      float values[kElementsPerLane];
+#pragma unroll
+      for (int i = 0; i < kElementsPerLane; ++i) {
+        values[i] = static_cast<float>(input[i]) * reciprocal_rms * weights[i];
+      }
+
+      vec_t output;
+      if constexpr (Interleave) {
+#pragma unroll
+        for (int i = 0; i < kElementsPerLane; i += 2) {
+          const float first = values[i];
+          const float second = values[i + 1];
+          output[i] = static_cast<scalar_t>(
+              i < rotary_count ? (first * cos_values[i] - second * sin_values[i]) * attention_factor : first);
+          output[i + 1] = static_cast<scalar_t>(
+              i + 1 < rotary_count ? (second * cos_values[i + 1] + first * sin_values[i + 1]) * attention_factor
+                                   : second);
+        }
+      } else {
+        switch (partner_lanes) {
+          case 1:
+            rotate_neox<1>(sg, values, cos_values, sin_values, first_dim, half_rotary, rotary_count, output);
+            break;
+          case 2:
+            rotate_neox<2>(sg, values, cos_values, sin_values, first_dim, half_rotary, rotary_count, output);
+            break;
+          case 4:
+            rotate_neox<4>(sg, values, cos_values, sin_values, first_dim, half_rotary, rotary_count, output);
+            break;
+          case 8:
+            rotate_neox<8>(sg, values, cos_values, sin_values, first_dim, half_rotary, rotary_count, output);
+            break;
+          default: {
+            const scalar_t* row = row_for(head);
+            const scalar_t* weight = is_q ? q_weight : k_weight;
+#pragma unroll
+            for (int i = 0; i < kElementsPerLane; ++i) {
+              if (i >= rotary_count) {
+                output[i] = static_cast<scalar_t>(values[i]);
+                continue;
+              }
+              const int dim = first_dim + i;
+              const bool lower = dim < half_rotary;
+              const int peer_dim = lower ? dim + half_rotary : dim - half_rotary;
+              const float peer =
+                  static_cast<float>(row[peer_dim]) * reciprocal_rms * static_cast<float>(weight[peer_dim]);
+              output[i] = static_cast<scalar_t>(
+                  (values[i] * cos_values[i] + (lower ? -peer : peer) * sin_values[i]) * attention_factor);
+            }
+            break;
+          }
+        }
+      }
+      if (store) *reinterpret_cast<vec_t*>(row_for(head) + first_dim) = output;
+    }
+  }
+};
+
+template <typename scalar_t, int HeadDim, bool Interleave>
+void launch_xe35(
+    scalar_t* qkv,
+    int num_tokens,
+    int num_heads_q,
+    int num_heads_k,
+    int num_heads_v,
+    float eps,
+    const scalar_t* q_weight,
+    const scalar_t* k_weight,
+    float base,
+    const int* position_ids,
+    float factor,
+    float low,
+    float high,
+    float attention_factor,
+    int rotary_dim,
+    sycl::queue& queue) {
+  constexpr int lanes = Kernel_xe35<scalar_t, HeadDim, Interleave, true>::kLanesPerHead;
+  const LaunchConfig_xe35 config = choose_launch_xe35<scalar_t, HeadDim, Interleave>(
+      num_tokens, num_heads_q + num_heads_k, lanes, num_heads_q + num_heads_k + num_heads_v);
+  const float* table = qk_rope_cached_frequencies_xe35(queue, base, rotary_dim, factor, low, high);
+  auto submit = [&]<bool UseTable>() {
+    Kernel_xe35<scalar_t, HeadDim, Interleave, UseTable> kernel{
+        qkv,
+        q_weight,
+        k_weight,
+        position_ids,
+        eps,
+        base,
+        factor,
+        low,
+        high,
+        attention_factor,
+        rotary_dim,
+        num_tokens,
+        num_heads_q,
+        num_heads_q + num_heads_k + num_heads_v,
+        num_heads_q + num_heads_k,
+        config,
+        partner_lanes_for_xe35(rotary_dim, Kernel_xe35<scalar_t, HeadDim, Interleave, UseTable>::kElementsPerLane),
+        qk_rope_frequency_storage_xe35<HeadDim, UseTable>(table, base, rotary_dim, factor, low, high)};
+    sycl_kernel_submit(sycl::range<1>(config.groups * config.wg_lanes), sycl::range<1>(config.wg_lanes), queue, kernel);
+  };
+  if (table)
+    submit.template operator()<true>();
+  else
+    submit.template operator()<false>();
+}
+
+}  // namespace at::native::xpu::qk_norm_rope_kernel_xe35
