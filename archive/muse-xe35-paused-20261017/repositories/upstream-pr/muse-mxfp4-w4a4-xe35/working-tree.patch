+  m.impl("mxfp4_moe_scale_to_mn_major_xe35", torch::kXPU, &mxfp4_moe_scale_to_mn_major_xe35);
+}
+#endif
diff --git a/tests/conftest.py b/tests/conftest.py
index 05a9532d4d6e5eb3bdf821f324000d8c366b8343..36e6b489f8368f0221eafc4847885e4d68002e6a 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -67,6 +67,28 @@ def clear_xpu_cache():
     if torch.xpu.is_available():
         torch.xpu.synchronize()
         torch.xpu.empty_cache()
+
+
+def pytest_addoption(parser):
+    parser.addoption(
+        "--run-long-tests",
+        action="store_true",
+        default=False,
+        help="Run production-size kernel cases and long simulator tests",
+    )
+
+
+def pytest_configure(config):
+    config.addinivalue_line("markers", "long_test: production-size or slow kernel case")
+
+
+def pytest_collection_modifyitems(config, items):
+    if config.getoption("--run-long-tests"):
+        return
