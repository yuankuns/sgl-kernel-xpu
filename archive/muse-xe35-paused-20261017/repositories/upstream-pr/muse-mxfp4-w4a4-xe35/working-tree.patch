+  using SGLayout = Layout<Shape<_2, _8, _1>, Stride<_8, _1, _0>>;
+  using TiledMma =
+      typename TiledMMAHelper<MMA_Atom<XE_DPAS_TT<8, float, ElementA>>, Layout<TileShape>, SGLayout>::TiledMMA;
+  static constexpr int PipelineStages = 2;
+  using GEMMDispatchPolicy = cutlass::gemm::MainloopFP8PerTensorGroup<PipelineStages>;
+  CALL_GENERATE_GEMM();
+};
+
+class moe_fp8pertensor_decode_policy_xe35 : public moe_fp8pertensor_policy_xe35 {
