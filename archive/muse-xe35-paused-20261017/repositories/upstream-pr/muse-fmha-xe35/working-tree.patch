+#pragma once
+
+namespace cute {
+
+/* Flat copies */
+template <class SrcEngine, class SrcLayout, class DstEngine, class DstLayout>
+CUTE_HOST_DEVICE void copy_block_r2s_xe35(Tensor<SrcEngine, SrcLayout> const& src, Tensor<DstEngine, DstLayout>& dst) {
+  static_assert(is_rmem_v<SrcEngine> && is_smem_v<DstEngine>, "Expected rmem->smem copy");
+
+  auto atom_r2s = Copy_Atom<XE_1D_STSM<float>, float>{};  // TODO: larger block messages
+  using _SG = intel::_SGSize;
+  int lane_id = int(ThreadIdxX()) % _SG{};
+
+  auto atom_shape = make_shape(_1{}, size(src));
+  auto src_v = src.compose(make_layout(atom_shape));
+  auto dst_composed = dst.compose(make_layout(atom_shape, Stride<_1, _SG>{}));
+  auto dst_v = make_tensor(dst_composed.data() + lane_id, dst_composed.layout());
+
+  copy(atom_r2s, src_v, dst_v);
+}
+
+template <class SrcEngine, class SrcLayout, class DstEngine, class DstLayout>
+CUTE_HOST_DEVICE void copy_block_s2r_xe35(Tensor<SrcEngine, SrcLayout> const& src, Tensor<DstEngine, DstLayout>& dst) {
+  static_assert(is_smem_v<SrcEngine> && is_rmem_v<DstEngine>, "Expected smem->rmem copy");
+
+  auto atom_s2r = Copy_Atom<XE_1D_LDSM<float>, float>{};
+  using _SG = intel::_SGSize;
+  int lane_id = int(ThreadIdxX()) % _SG{};
+
+  auto atom_shape = make_shape(_1{}, size(dst));
+  auto src_composed = src.compose(make_layout(atom_shape, Stride<_1, _SG>{}));
+  auto src_v = make_tensor(src_composed.data() + lane_id, src_composed.layout());
+  auto dst_v = dst.compose(make_layout(atom_shape));
+
+  copy(atom_s2r, src_v, dst_v);
+}
+
+/* Coordinate-aware copies */
+template <
+    class SrcEngine,
+    class SrcLayout,
+    class SrcCoordLayout,
+    class DstEngine,
+    class DstLayout,
+    class DstCoordLayout>
+CUTE_HOST_DEVICE void copy_block_r2s_xe35(
+    SubgroupTensor<SrcEngine, SrcLayout, SrcCoordLayout> const& src,
+    Tensor<DstEngine, DstLayout>& dst,
+    DstCoordLayout const& dst_c) {
+  using _SG = intel::_SGSize;
+
+  static_assert(is_rmem_v<SrcEngine> && is_smem_v<DstEngine>, "Expected rmem->smem copy");
+  static_assert(sizeof_bits_v<typename SrcEngine::value_type> == 32, "Only 32-bit data supported");
+
+  auto atom_r2s = Copy_Atom<XE_1D_STSM<float>, float>{};  // TODO: larger block messages
+  int lane_id = int(ThreadIdxX()) % _SG{};
+
+  auto atom_shape = make_shape(_1{}, size(SrcLayout{}));
+
+  auto src_c_wi0 = composition(project_strides(SrcCoordLayout{}), make_layout(atom_shape, Stride<_1, _SG>{}));
+  auto rlayout = composition(right_inverse(project_strides(dst_c)), src_c_wi0);
+
+  auto src_v = src.compose(make_layout(atom_shape));
+  auto dst_composed = dst.compose(rlayout);
+  auto dst_v = make_tensor(dst_composed.data() + lane_id, dst_composed.layout());
+
+  copy(atom_r2s, src_v, dst_v);
+}
+
+template <
+    class SrcEngine,
+    class SrcLayout,
+    class SrcCoordLayout,
+    class DstEngine,
+    class DstLayout,
+    class DstCoordLayout>
+CUTE_HOST_DEVICE void copy_block_s2r_xe35(
+    Tensor<SrcEngine, SrcLayout> const& src,
+    SrcCoordLayout const& src_c,
+    SubgroupTensor<DstEngine, DstLayout, DstCoordLayout>& dst) {
+  using _SG = intel::_SGSize;
+
+  static_assert(is_smem_v<SrcEngine> && is_rmem_v<DstEngine>, "Expected smem->rmem copy");
+  static_assert(sizeof_bits_v<typename SrcEngine::value_type> == 32, "Only 32-bit data supported");
+
+  auto atom_s2r = Copy_Atom<XE_1D_LDSM<float>, float>{};
+  int lane_id = int(ThreadIdxX()) % _SG{};
+
+  auto atom_shape = make_shape(_1{}, size(DstLayout{}));
+
+  auto dst_c_wi0 = composition(project_strides(DstCoordLayout{}), make_layout(atom_shape, Stride<_1, _SG>{}));
+  auto rlayout = composition(right_inverse(project_strides(src_c)), dst_c_wi0);
+
+  auto src_composed = src.compose(rlayout);
+  auto src_v = make_tensor(src_composed.data() + lane_id, src_composed.layout());
+  auto dst_v = dst.compose(make_layout(atom_shape));
+
+  copy(atom_s2r, src_v, dst_v);
+}
+
+/* Variants accepting rvalue dst */
+template <class SrcEngine, class SrcLayout, class DstEngine, class DstLayout>
+CUTE_HOST_DEVICE void copy_block_r2s_xe35(Tensor<SrcEngine, SrcLayout> const& src, Tensor<DstEngine, DstLayout>&& dst) {
+  return copy_block_r2s_xe35(src, dst);
+}
+
+template <class SrcEngine, class SrcLayout, class DstEngine, class DstLayout>
+CUTE_HOST_DEVICE void copy_block_s2r_xe35(Tensor<SrcEngine, SrcLayout> const& src, Tensor<DstEngine, DstLayout>&& dst) {
+  return copy_block_s2r_xe35(src, dst);
+}
+
+template <
+    class SrcEngine,
+    class SrcLayout,
+    class SrcCoordLayout,
+    class DstEngine,
+    class DstLayout,
+    class DstCoordLayout>
+CUTE_HOST_DEVICE void copy_block_r2s_xe35(
+    SubgroupTensor<SrcEngine, SrcLayout, SrcCoordLayout> const& src,
+    Tensor<DstEngine, DstLayout>&& dst,
+    DstCoordLayout const& dst_c) {
+  return copy_block_r2s_xe35(src, dst, dst_c);
+}
+
+template <
+    class SrcEngine,
+    class SrcLayout,
+    class SrcCoordLayout,
+    class DstEngine,
+    class DstLayout,
+    class DstCoordLayout>
+CUTE_HOST_DEVICE void copy_block_s2r_xe35(
+    Tensor<SrcEngine, SrcLayout> const& src,
+    SrcCoordLayout const& src_c,
+    SubgroupTensor<DstEngine, DstLayout, DstCoordLayout>&& dst) {
+  return copy_block_s2r_xe35(src, src_c, dst);
+}
+
+} /* namespace cute */
diff --git a/src/sycl/xe35/fmha/collective/copy_payloads.hpp b/src/sycl/xe35/fmha/collective/copy_payloads.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..8f878d1c7223bbee378ad58f07853fbdb60b0cd0
--- /dev/null
+++ b/src/sycl/xe35/fmha/collective/copy_payloads.hpp
@@ -0,0 +1,238 @@
+#pragma once
+#include <cute/atom/copy_traits_xe_2d.hpp>
+
+namespace cute {
+template <int N, class BaseT = void>
+struct Xe2DPreparedPayloads_xe35 {
+  int* payloads[N];
+
+  template <int Field>
+  CUTE_DEVICE static void add_payload_field_xe35(int* payload, int32_t delta) {
+    static_assert(Field == 5 || Field == 6, "Only block X/Y payload fields can be updated.");
+#ifdef __SYCL_DEVICE_ONLY__
+    asm volatile(
+        "{\n"
+        ".decl PAYLOAD_D v_type=G type=D num_elts=8 alias=<%0,0>\n"
+        ".decl DELTA_D v_type=G type=D num_elts=1 alias=<%1,0>\n"
+        "add (M1_NM, 1) PAYLOAD_D(0,%2)<1> PAYLOAD_D(0,%2)<0;1,0> DELTA_D(0,0)<0;1,0>\n"
+        "}\n"
+        :
+        : "rw.u"(payload), "rw.u"(delta), "P"(Field));
+#else
+    (void) payload;
+    (void) delta;
+    CUTE_INVALID_CONTROL_PATH("Xe 2D payload updates are only available on SYCL device.");
+#endif
+  }
+
+  // Advance all N payloads by `delta` in the copy's coordinate space.
+  //
+  // get<> preserves per-element type: static elements (e.g. _0, C<8>) yield
+  // integral_constant types whose arithmetic the compiler folds into immediates.
+  // Zero-valued dimensions are elided entirely via if-constexpr on is_constant_v.
+  template <class Coord>
+  CUTE_DEVICE Xe2DPreparedPayloads_xe35& operator+=(Coord const& delta) {
+    using Op = typename BaseT::CopyOp;
+    static_assert(!BaseT::nontrivial_tiled_strides,
+                  "Payload updates are only supported for modes handled by block 2D messages.");
+#ifdef __SYCL_DEVICE_ONLY__
+    auto dx = get<decltype(BaseT::get_x_mode())::value>(delta);
+    auto dy = get<decltype(BaseT::get_y_mode())::value>(delta);
+    CUTE_UNROLL
+    for (int i = 0; i < N; ++i) {
+      if constexpr (!is_constant_v<0, decltype(dx)>) {
+        add_payload_field_xe35<5>(payloads[i], int32_t(dx) * BaseT::ValBits / Op::CopyBits);
+      }
+      if constexpr (!is_constant_v<0, decltype(dy)>) {
+        add_payload_field_xe35<6>(payloads[i], int32_t(dy));
+      }
+    }
+#else
+    (void) delta;
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    return *this;
+  }
+
+  // Convenience: treat a compile-time constant as a Y-only step.
+  // Preserves static type so the inner operator+= takes the compile-time path.
+  // Usage: prepared += C<SG_K>{};
+  template <int Step>
+  CUTE_DEVICE Xe2DPreparedPayloads_xe35& operator+=(C<Step>) {
+    return *this += make_coord(_0{}, C<Step>{});
+  }
+
+  // Convenience: treat a runtime int as a Y-only step.
+  CUTE_DEVICE Xe2DPreparedPayloads_xe35& operator+=(int step) {
+    return *this += make_coord(_0{}, step);
+  }
+};
+
+namespace detail_payloads_xe35 {
+
+template <class Op, class XMode, class YMode, typename ValType, typename TiledStrides>
+CUTE_HOST_DEVICE
+Xe2DTraitsBase<Op, XMode, YMode, ValType, TiledStrides> const&
+as_xe2d_base_xe35(Xe2DTraitsBase<Op, XMode, YMode, ValType, TiledStrides> const& o) {
+  return o;
+}
+
+// Recursively create one payload per copy atom, traversing via nullspace.
+template <int NumValDst, int N, class BaseT,
+          class SEngine, class SLayout>
+CUTE_DEVICE void
+prepare_payloads_xe35(BaseT const& base,
+                      Tensor<SEngine, SLayout> const& src,
+                      Xe2DPreparedPayloads_xe35<N, BaseT>& payloads,
+                      int& idx)
+{
+  using Op    = typename BaseT::CopyOp;
+  constexpr int ValBits = BaseT::ValBits;
+
+  if constexpr (SLayout::rank == 1 && decltype(size(SLayout{}))::value == NumValDst) {
+#ifdef __SYCL_DEVICE_ONLY__
+    using XMode = decltype(BaseT::get_x_mode());
+    using YMode = decltype(BaseT::get_y_mode());
+    auto coord = src.data().coord_;
+    int32_t x = get<XMode::value>(coord) * ValBits / Op::CopyBits;
+    int32_t y = get<YMode::value>(coord);
+    uint64_t bp = base.base_ptr;
+    if constexpr (BaseT::nontrivial_tiled_strides) {
+      auto off = inner_product(coord, base.tiled_strides);
+      bp += (off * ValBits) >> 3;
+    }
+    payloads.payloads[idx] =
+        __builtin_IB_subgroup_copyBlock2DAddressPayload(base.payload);
+        __builtin_IB_subgroup_setBlock2DAddressPayloadBlockX(payloads.payloads[idx], x);
+        __builtin_IB_subgroup_setBlock2DAddressPayloadBlockY(payloads.payloads[idx], y);
+    if constexpr (BaseT::nontrivial_tiled_strides) {
+      __builtin_IB_subgroup_setBlock2DAddressPayloadBase(payloads.payloads[idx], bp);
+    }
+#else
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    ++idx;
+  } else if constexpr (SLayout::rank > 1) {
+    constexpr int R = SLayout::rank;
+    auto src_v = group_modes<1, R>(src);
+    auto src_null = nullspace(layout<1>(src_v));
+    auto src_n = zipped_divide(src_v, make_tile(shape<0>(src_v), src_null));
+    auto src_c = src_n(make_coord(_, Int<0>{}), make_coord(Int<0>{}, _));
+    constexpr int Rest = decltype(size<1>(src_c))::value;
+    CUTE_UNROLL
+    for (int i = 0; i < Rest; ++i) {
+      auto s_i = src_c(_, i);
+      prepare_payloads_xe35<NumValDst>(base, s_i, payloads, idx);
+    }
+  } else {
+    static_assert(is_tuple<decltype(shape<0>(SLayout{}))>::value,
+                  "Cannot peel further: V mode is atomic but size does not match NumValDst");
+    auto s_sub = tensor<0>(src);
+    prepare_payloads_xe35<NumValDst>(base, s_sub, payloads, idx);
+  }
+}
+
+// Recursively issue one load per copy atom, traversing via nullspace.
+template <int NumValDst, int N, class BaseT,
+          class DEngine, class DLayout>
+CUTE_DEVICE void
+copy_payloads_xe35(BaseT const& base,
+                   Tensor<DEngine, DLayout>& dst,
+                   Xe2DPreparedPayloads_xe35<N, BaseT> const& payloads,
+                   int& idx)
+{
+  using Op    = typename BaseT::CopyOp;
+  constexpr int ValBits = BaseT::ValBits;
+
+  if constexpr (DLayout::rank == 1 && decltype(size(DLayout{}))::value == NumValDst) {
+#ifdef __SYCL_DEVICE_ONLY__
+    using ValT = int_byte_t<bits_to_bytes(ValBits)>;
+    Op::copy(payloads.payloads[idx],
+             const_cast<ValT*>(recast_ptr<ValT>(raw_pointer_cast(dst.data()))));
+#else
+    CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+    ++idx;
+  } else if constexpr (DLayout::rank > 1) {
+    constexpr int R = DLayout::rank;
+    auto dst_v = group_modes<1, R>(dst);
+    auto dst_null = nullspace(layout<1>(dst_v));
+    auto dst_n = zipped_divide(dst_v, make_tile(shape<0>(dst_v), dst_null));
+    auto dst_c = dst_n(make_coord(_, Int<0>{}), make_coord(Int<0>{}, _));
+    constexpr int Rest = decltype(size<1>(dst_c))::value;
+    CUTE_UNROLL
+    for (int i = 0; i < Rest; ++i) {
+      auto d_i = dst_c(_, i);
+      copy_payloads_xe35<NumValDst>(base, d_i, payloads, idx);
+    }
+  } else {
+    static_assert(is_tuple<decltype(shape<0>(DLayout{}))>::value,
+                  "Cannot peel further: V mode is atomic but size does not match NumValDst");
+    auto d_sub = tensor<0>(dst);
+    copy_payloads_xe35<NumValDst>(base, d_sub, payloads, idx);
+  }
+}
+
+} // namespace detail
+
+// TODO: Fold these multi-payload API into the generic cute::copy / cute::prefetch_xe35 paths
+template <class TiledCopy,
+          class Engine, class Layout>
+CUTE_DEVICE auto
+prepare_payloads_xe35(TiledCopy const& tiled_copy,
+                  Tensor<Engine, Layout> const& tensor)
+{
+  static_assert(is_counting_layout_v<Layout>, "tensor must be a coordinate tensor.");
+  auto const& base = detail_payloads_xe35::as_xe2d_base_xe35(tiled_copy);
+  using BaseT = remove_cvref_t<decltype(base)>;
+  constexpr int NumValDst = decltype(size<1>(typename BaseT::Traits::DstLayout{}))::value / BaseT::ValBits;
+  constexpr int Total     = decltype(size(Layout{}))::value;
+  static_assert(Total % NumValDst == 0,
+                "src tensor size is not a multiple of per-atom size");
+  constexpr int N = Total / NumValDst;
+
+  Xe2DPreparedPayloads_xe35<N, BaseT> prepared{};
+  int idx = 0;
+  detail_payloads_xe35::prepare_payloads_xe35<NumValDst>(base, tensor, prepared, idx);
+  return prepared;
+}
+
+template <class TiledCopy, int N, class BaseT, class Engine, class Layout>
+CUTE_DEVICE void
+copy_payloads_xe35(TiledCopy const& tiled_copy,
+     Xe2DPreparedPayloads_xe35<N, BaseT> const& prepared,
+     Tensor<Engine, Layout>& tensor)
+{
+  static_assert(is_rmem_v<Engine>, "tensor must be in registers.");
+  auto const& base = detail_payloads_xe35::as_xe2d_base_xe35(tiled_copy);
+  constexpr int NumValDst = decltype(size<1>(typename BaseT::Traits::DstLayout{}))::value / BaseT::ValBits;
+
+  int idx = 0;
+  detail_payloads_xe35::copy_payloads_xe35<NumValDst>(base, tensor, prepared, idx);
+}
+
+template <class TiledCopy, int N, class BaseT>
+CUTE_DEVICE void
+prefetch_xe35(TiledCopy const& tiled_copy,
+                       Xe2DPreparedPayloads_xe35<N, BaseT> const& prepared)
+{
+  auto const& base = detail_payloads_xe35::as_xe2d_base_xe35(tiled_copy);
+  using Op = typename BaseT::CopyOp;
+#ifdef __SYCL_DEVICE_ONLY__
+  CUTE_UNROLL
+  for (int i = 0; i < N; ++i) {
+    Op::copy(prepared.payloads[i]);
+  }
+#else
+  (void) base;
+  (void) prepared;
+  CUTE_INVALID_CONTROL_PATH("Xe 2D multi-payload copies are only available on SYCL device.");
+#endif
+}
+
+
+template <class TiledCopy, class Engine, class Layout>
+CUTE_DEVICE void prefetch_xe35(TiledCopy const& operation, Tensor<Engine, Layout> const& tensor) {
+  prefetch(operation, tensor);
+}
+}
diff --git a/src/sycl/xe35/fmha/collective/copy_traits_cache.hpp b/src/sycl/xe35/fmha/collective/copy_traits_cache.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..34015feef04abfac1ed03a7ee9391f5805ea8b45
--- /dev/null
+++ b/src/sycl/xe35/fmha/collective/copy_traits_cache.hpp
@@ -0,0 +1,261 @@
+#pragma once
+#include <cute/atom/copy_traits_xe_2d.hpp>
+
+namespace cute {
+enum class XeStoreCachePolicy_xe35 {
+  kDefault,
+  kUC_UC_UC,
+  kUC_UC_WB,
+  kUC_WB_UC,
+  kUC_WB_WB,
+  kWT_UC_UC,
+  kWT_UC_WB,
+  kWT_WB_UC,
+  kWT_WB_WB,
+  kWB_UC_UC,
+  kWB_UC_WB,
+  kWB_WB_UC,
+  kST_UC_UC,
+  kST_UC_WB,
+  kST_WB_UC
+};
+
+#define CUTE_XE_STORE_2D_ASM_XE35(CACHE_SUFFIX)                                      \
+  asm (                                                                         \
+    "lsc_store_block2d.ugm" CACHE_SUFFIX                                        \
+    " (M1, 1) flat[%1+(0,0)] %0:d%2.%3x%4nn"                                    \
+      :: "rw"(sv), "rw.u"(payload), "P"(Bits), "P"(Width), "P"(Height)         \
+  )
+
+template <int Bits, int Height, int Width, XeStoreCachePolicy_xe35 CachePolicy = XeStoreCachePolicy_xe35::kDefault>
+struct XE_STORE_2D_xe35 : XE_Copy_Op_2D_Base<Bits, Height, Width>
+{
+  static_assert(Height <= 8, "Height exceeds hardware limits");
+  static constexpr XeStoreCachePolicy_xe35 StoreCachePolicy = CachePolicy;
+
+  template <typename T>
+  CUTE_HOST_DEVICE static void copy(const int *payload, const T *src) {
+#ifdef CUTE_ARCH_COPY_XE_ENABLED
+    using namespace intel;
+    auto &sv = *reinterpret_cast<const storage_vector_t<T, Width * Height * Bits / sg_size>*>(src);
+    if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kDefault) {
+      CUTE_XE_STORE_2D_ASM_XE35("");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kUC_UC_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".uc.uc.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kUC_UC_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".uc.uc.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kUC_WB_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".uc.wb.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kUC_WB_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".uc.wb.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWT_UC_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wt.uc.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWT_UC_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wt.uc.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWT_WB_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wt.wb.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWT_WB_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wt.wb.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWB_UC_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wb.uc.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWB_UC_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wb.uc.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kWB_WB_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".wb.wb.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kST_UC_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".st.uc.uc");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kST_UC_WB) {
+      CUTE_XE_STORE_2D_ASM_XE35(".st.uc.wb");
+    } else if constexpr (CachePolicy == XeStoreCachePolicy_xe35::kST_WB_UC) {
+      CUTE_XE_STORE_2D_ASM_XE35(".st.wb.uc");
+    } else {
+      static_assert(dependent_false<integral_constant<XeStoreCachePolicy_xe35, CachePolicy>>,
+                    "Unsupported Xe store cache policy");
+    }
+#else
+    CUTE_INVALID_CONTROL_PATH("Cannot use Xe block 2D copy atom on non-Xe hardware");
+#endif
+  }
+};
+
+#undef CUTE_XE_STORE_2D_ASM_XE35
+template <class XMode, class YMode, typename ValType, typename TiledStrides,
+      int CopyBits, int Height, int Width, XeStoreCachePolicy_xe35 CachePolicy>
+struct Copy_Traits<XE_STORE_2D_xe35<CopyBits, Height, Width, CachePolicy>, XMode, YMode, ValType, TiledStrides>
+  : Xe2DTraitsBase<XE_STORE_2D_xe35<CopyBits, Height, Width, CachePolicy>, XMode, YMode, ValType, TiledStrides>
+{
+  // (src-thr, src-val) -> (x, y)
+  using SrcLayout = XeInterleavedLayout<Layout<Shape<Int<Width>, Int<Height>>>,
+                                        CopyBits,
+                                        sizeof_bits_v<ValType>>;
+
+  using RefLayout = SrcLayout;
+  using DstLayout = decltype(replace<0>(RefLayout{}, Layout<Shape<intel::_SGSize>, Stride<_0>>{}));
+
+  using Op = XE_STORE_2D_xe35<CopyBits, Height, Width, CachePolicy>;
+  using Super = Xe2DTraitsBase<Op, XMode, YMode, ValType, TiledStrides>;
+  using Traits = typename Super::Traits;  // a.k.a. this class
+  using ThrID = typename Super::ThrID;
+
+  using Super::Super;
+
+  // Execution.
+  template <class SEngine, class SLayout,
+            class DEngine, class DLayout>
+  CUTE_DEVICE friend constexpr void
+  copy_unpack(Traits const&                   traits,
+              Tensor<SEngine, SLayout> const& src,
+              Tensor<DEngine, DLayout> &      dst) {
+    using SType = typename SEngine::value_type;
+    using DType = typename DEngine::value_type;
+    using SrcLayout = typename Traits::SrcLayout;
+    using DstLayout = typename Traits::DstLayout;
+    constexpr auto SBits = sizeof_bits_v<SType>;
+
+    static_assert(is_counting_layout_v<DLayout>, "Destination tensor must be a coordinate tensor.");
+    static_assert(is_rmem_v<SEngine>, "Source tensor must be in registers.");
+    static_assert(size(SLayout{}) * SBits == size<1>(SrcLayout{}),
+                  "Source tensor size does not match copy atom size.");
+    static_assert(size(DLayout{}) * SBits == size<1>(DstLayout{}),
+                  "Destination tensor size does not match copy atom size.");
+
+    traits.template update_payload<SBits>(dst.data().coord_);
+    Op::copy(traits.payload, recast_ptr<int_byte_t<bits_to_bytes(Super::ValBits)>>(raw_pointer_cast(src.data())));
+  }
+};
+template<int Bits, int Height, int Width, XeStoreCachePolicy_xe35 Policy>
+struct is_xe_block_2d_atom<XE_STORE_2D_xe35<Bits,Height,Width,Policy>> : std::true_type {};
+template <typename MemType, typename RegType, bool Store = false,
+          XeStoreCachePolicy_xe35 StoreCachePolicy = XeStoreCachePolicy_xe35::kDefault,
+          typename CoordLayout, typename GlobalStride>
+CUTE_HOST_DEVICE
+constexpr auto
+block_2d_selector_xe35(CoordLayout const&, GlobalStride const&)
+{
+  static_assert(is_static_v<CoordLayout>, "Coordinate layout must be static");
+
+  auto layout = coalesce(CoordLayout{});
+  GlobalStride gstride{};
+
+  // Determine size of copy.
+  constexpr int MemBits = sizeof_bits_v<MemType>;
+  constexpr int RegBits = sizeof_bits_v<RegType>;
+
+  // Determine which kind of block 2D message to use (regular/VNNI/transpose)
+  constexpr auto kind = block_2d_transform_selector<MemBits, RegBits, Store>(layout, gstride);
+
+  // Strip off VNNI mode if present.
+  constexpr auto slayout = get<0>(strip_vnni_subbyte<RegBits>(layout));
+
+  constexpr auto x_mode = find_x_mode(gstride);
+  constexpr auto y_mode = find_y_mode(gstride);
+
+  constexpr int min_large_block = cute::min(256 / RegBits, 16);
+  constexpr bool resize = (MemBits != RegBits);
+
+  auto shape = atuple_coshape(layout);
+
+  if constexpr (kind != Block2DTransform::T) {
+    constexpr int CopyBits = cute::max(8, cute::min(64, MemBits));
+
+    // Determine block width.
+    // Get innermost stride in x dimension that is >= 1/2 GRF
+    //   Block width = highest power of 2 divisor (up to 64b)
+    //   Width = highest power of 2 divisor of full tile's width, up to 64b and 4x block width
+    constexpr int max_w = 64 * 8 / MemBits;
+    constexpr int x_stride = get_block_size<x_mode(), min_large_block>(slayout);
+    constexpr int block_width = cute::gcd(max_w, x_stride);
+    constexpr int load_width = cute::gcd(cute::min(max_w, 4 * block_width),
+                                          get<x_mode()>(shape));
+    constexpr int width = Store ? block_width : load_width;
+    constexpr int block_cwidth = block_width * MemBits / CopyBits;
+    constexpr int cwidth = width * MemBits / CopyBits;
+
+    // Determine block height.
+    // Get innermost stride in H dimension, besides VNNI stride if VNNI.
+    // However, if data resizing will occur, choose full tile height, up to block height limit.
+    //   (Rationale: we are already moving data, so layouts don't need to match)
+    constexpr int y_stride = get_block_size<y_mode()>(slayout);
+    constexpr int max_h = Store ? 8 : 32;
+#if (SYCL_INTEL_TARGET == 35)
+    constexpr int height = Store ? cute::gcd(resize ? get<y_mode()>(shape) : y_stride, max_h) :
+                                   cute::gcd(get<y_mode()>(shape), max_h);
+#else
+    constexpr int height = cute::gcd(resize ? get<y_mode()>(shape) : y_stride, max_h);
+#endif
+
+    if constexpr (Store)
+      return XE_STORE_2D_xe35    <CopyBits, height, cwidth, StoreCachePolicy>{};
+    else if constexpr (kind == Block2DTransform::V)
+      return XE_LOAD_2D_VNNI<CopyBits, height, cwidth, block_cwidth>{};
+    else
+      return XE_LOAD_2D     <CopyBits, height, cwidth, block_cwidth>{};
+  } else {
+    // Similar process for transposing copies, but with width/height reversed.
+    constexpr int CopyBits = cute::max(32, cute::min(64, MemBits));
+
+    constexpr int y_stride = get_block_size<y_mode(), min_large_block>(slayout);
+    constexpr int height = cute::gcd(32, y_stride);
+
+    // Transpose Width limits (in CopyBits-element units):
+    //   d32: <=8 on Xe2; <=16 on Xe3P+.
+    //   d64: <=4 on Xe2; <=8 on Xe3P+.
+#if (SYCL_INTEL_TARGET == 35)
+    constexpr int max_cwidth_d32 = 16;
+    constexpr int max_cwidth_d64 = 8;
+#else
+    constexpr int max_cwidth_d32 = 8;
+    constexpr int max_cwidth_d64 = 4;
+#endif
+    constexpr int max_cwidth = (CopyBits == 64) ? max_cwidth_d64 : max_cwidth_d32;
+    constexpr int max_w = max_cwidth * CopyBits / MemBits;
+    constexpr int width = cute::gcd(get<x_mode()>(shape), max_w);
+    constexpr int cwidth = width * MemBits / CopyBits;
+
+    return XE_LOAD_2D_TRANSPOSE<CopyBits, height, cwidth>{};
+  }
+}
+template <class ValType, class TiledMMA, class... Strides>
+CUTE_HOST_DEVICE auto make_block_2d_copy_A_xe35(TiledMMA const& mma, Stride<Strides...> const& gstride) {
+  using MMAType = typename TiledMMA::ValTypeA;
+  auto coordinates = make_identity_tensor(select<0,2>(mma.tile_mnk()));
+  auto operation = block_2d_selector_xe35<ValType, MMAType>(mma.get_slice(0).atom_partition_A(coordinates).layout(), gstride);
+  return make_block_2d_copy_A<ValType>(operation, mma, gstride);
+}
+template <class TiledMMA, class GEngine, class GLayout>
+CUTE_HOST_DEVICE auto make_block_2d_copy_A_xe35(TiledMMA const& mma, Tensor<GEngine, GLayout> const& gmem) {
+  using ValType = typename GEngine::value_type;
+  return make_block_2d_copy_A_xe35<ValType>(mma, gmem.stride()).with(gmem);
+}
+template <class ValType, class TiledMMA, class... Strides>
+CUTE_HOST_DEVICE auto make_block_2d_copy_B_xe35(TiledMMA const& mma, Stride<Strides...> const& gstride) {
+  using MMAType = typename TiledMMA::ValTypeB;
+  auto coordinates = make_identity_tensor(select<1,2>(mma.tile_mnk()));
+  auto operation = block_2d_selector_xe35<ValType, MMAType>(mma.get_slice(0).atom_partition_B(coordinates).layout(), gstride);
+  return make_block_2d_copy_B<ValType>(operation, mma, gstride);
+}
+template <class TiledMMA, class GEngine, class GLayout>
+CUTE_HOST_DEVICE auto make_block_2d_copy_B_xe35(TiledMMA const& mma, Tensor<GEngine, GLayout> const& gmem) {
+  using ValType = typename GEngine::value_type;
+  return make_block_2d_copy_B_xe35<ValType>(mma, gmem.stride()).with(gmem);
+}
+template <XeStoreCachePolicy_xe35 Policy, class ValType, class TiledMMA, class... Strides>
+CUTE_HOST_DEVICE auto make_block_2d_copy_D_xe35(TiledMMA const& mma, Stride<Strides...> const& gstride) {
+  using MMAType = typename TiledMMA::ValTypeD;
+  auto coordinates = make_identity_tensor(select<0,1>(mma.tile_mnk()));
+  auto operation = block_2d_selector_xe35<ValType, MMAType, true, Policy>(mma.get_slice(0).atom_partition_C(coordinates).layout(), gstride);
+  return make_block_2d_copy_CD<ValType>(operation, mma, gstride);
+}
+template <XeStoreCachePolicy_xe35 Policy, class TiledMMA, class GEngine, class GLayout>
+CUTE_HOST_DEVICE auto make_block_2d_copy_D_xe35(TiledMMA const& mma, Tensor<GEngine, GLayout> const& gmem) {
+  using ValType = typename GEngine::value_type;
+  return make_block_2d_copy_D_xe35<Policy, ValType>(mma, gmem.stride()).with(gmem);
+}
+template <XeStoreCachePolicy_xe35 Policy, class TiledMMA, class SubtileTVCoordLayout, class SubtileSGLayout, class GEngine, class GLayout>
+CUTE_HOST_DEVICE auto make_block_2d_copy_D_subtiled_xe35(TiledMMA const& mma, SubtileTVCoordLayout const& tv_layout, SubtileSGLayout const& sg_layout, Tensor<GEngine, GLayout> const& gmem) {
+  using ValType = typename GEngine::value_type;
+  using MMAType = typename TiledMMA::ValTypeD;
+  auto operation = block_2d_selector_xe35<ValType, MMAType, true, Policy>(tv_layout, gmem.stride());
+  return make_block_2d_copy_CD_subtiled<ValType>(operation, mma, atuple_coshape(tv_layout), sg_layout, gmem.stride()).with(gmem);
+}
+} 
