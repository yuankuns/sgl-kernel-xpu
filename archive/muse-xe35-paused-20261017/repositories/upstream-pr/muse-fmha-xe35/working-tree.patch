+#pragma once
+
+#include <cute/tensor.hpp>
+
+#include "cutlass/cutlass.h"
+
+namespace cutlass::fmha_xe35::collective {
+
+using namespace cute;
+
+struct VariableLength_xe35 {
+  int max_length;
+  int total_length = 0;
+  int* cumulative_length = nullptr;
+  int* cumulative_scale_length = nullptr;
+
+  CUTE_HOST_DEVICE operator int() const {
+    return max_length;
+  }
+};
+
+template <class T>
+struct is_variable_length_xe35 : std::false_type {};
+template <>
+struct is_variable_length_xe35<VariableLength_xe35> : std::true_type {};
+template <class T>
+constexpr bool is_variable_length_v = is_variable_length_xe35<T>::value;
+
+template <class Shape, class Idx>
+CUTE_HOST_DEVICE constexpr auto apply_variable_length_xe35(Shape const& shape, Idx const& idx) {
+  return transform_leaf(shape, [&](auto const& s) {
+    if constexpr (is_variable_length_v<remove_cvref_t<decltype(s)>>) {
+      // A null cumulative_length means this sequence is absent (e.g. no new KV);
+      // fall back to max_length, which is 0 in that case.
+      return s.cumulative_length ? (s.cumulative_length[idx + 1] - s.cumulative_length[idx]) : s.max_length;
+    } else {
+      return s;
+    }
+  });
+}
+
+template <class Shape, class Coord, class Idx>
+CUTE_HOST_DEVICE constexpr auto apply_variable_length_xe35(Shape const& shape, Coord const& coord, Idx const& idx) {
+  auto new_shape = apply_variable_length_xe35(shape, idx);
+  auto new_coord = transform_leaf(shape, coord, [&](auto const& s, auto const& c) {
+    if constexpr (is_variable_length_v<remove_cvref_t<decltype(s)>>) {
+      return cute::make_tuple(c, s.cumulative_length ? s.cumulative_length[idx] : 0);
+    } else {
+      return c;
+    }
+  });
+  return cute::make_tuple(new_shape, new_coord);
+}
+
+}  // namespace cutlass::fmha_xe35::collective
+
+namespace cute {
+
+template <>
+struct is_integral<cutlass::fmha_xe35::collective::VariableLength_xe35> : true_type {};
+
+CUTE_HOST_DEVICE
+void print(cutlass::fmha_xe35::collective::VariableLength_xe35 a) {
+  printf("Varlen<%d, %p>", a.max_length, a.cumulative_length);
+}
+
+}  // namespace cute
