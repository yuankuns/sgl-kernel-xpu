+#pragma once
+
+#include "sycl/xe35/fmha/xe_fmha_fwd_decode_runner.hpp"
+
+SGL_KERNEL_EXPORT Xe35DispatchFn_xe35 dispatch_xe35_decode_64_bf16_xe35;
+SGL_KERNEL_EXPORT Xe35DispatchFn_xe35 dispatch_xe35_decode_64_fp8_e4m3_xe35;
