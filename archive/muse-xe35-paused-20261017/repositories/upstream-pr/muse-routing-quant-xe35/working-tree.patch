+        activated = torch.empty(1, 32, dtype=dtype, device=self.device)
+        silu_and_mul(x, out=activated)
+        quant = self._import_kernel_xe35()
+        values_cpu = x.cpu().float()
+        expected_activation = (
+            torch.nn.functional.silu(values_cpu[:, :32]) * values_cpu[:, 32:]
