+    int64_t page_size);
+SGL_KERNEL_EXPORT void paged_alloc_decode_xe35(
+    torch::Tensor seq_lens,
+    torch::Tensor last_loc,
+    torch::Tensor free_pages,
+    torch::Tensor out_indices,
+    int64_t page_size);
+
+}
