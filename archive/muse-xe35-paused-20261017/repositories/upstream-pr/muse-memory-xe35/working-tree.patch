+    torch::Tensor req_to_token,
+    torch::Tensor req_pool_indices,
+    torch::Tensor prefix_pointers,
+    torch::Tensor prefix_lens,
+    torch::Tensor seq_lens,
+    torch::Tensor extend_lens,
+    torch::Tensor out_cache_loc);
