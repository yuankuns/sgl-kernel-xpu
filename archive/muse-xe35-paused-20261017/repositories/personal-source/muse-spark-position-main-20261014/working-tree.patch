index 0000000000000000000000000000000000000000..596be553a9812a63e992c30f7fa1388b679cfcdf
--- /dev/null
+++ b/artifacts/position/MuseComputePosition.before.cpp
@@ -0,0 +1,143 @@
+#include <ATen/ATen.h>
+#include <c10/xpu/XPUStream.h>
+#include <torch/all.h>
+
+#include <algorithm>
+#include <sycl/sycl.hpp>
+
+#include "SYCLHelpers.h"
+
+namespace at::native::xpu {
+namespace {
+
+constexpr int kPositionWorkgroup = 256;
+
+template <typename PrefixScalar, typename SeqScalar>
+struct MuseComputePositionKernel {
+  int64_t* __restrict__ positions;
+  int32_t* __restrict__ extend_start_loc;
+  const PrefixScalar* __restrict__ prefix_lens;
+  const SeqScalar* __restrict__ seq_lens;
+  int64_t batch;
+  int64_t groups_per_request;
+  bool has_prefix;
+
+  void operator()(sycl::nd_item<1> item) const {
+    const int64_t req = item.get_group(0) / groups_per_request;
+    const int64_t tile = item.get_group(0) % groups_per_request;
+    const int64_t lane = item.get_local_id(0);
+    if (req >= batch) {
+      return;
+    }
+    int64_t start = 0;
+    for (int64_t i = 0; i < req; ++i) {
+      start += seq_lens[i];
+    }
+    const int64_t prefix = has_prefix ? prefix_lens[req] : 0;
+    const int64_t extend = seq_lens[req];
+    for (int64_t i = tile * kPositionWorkgroup + lane; i < extend; i += groups_per_request * kPositionWorkgroup) {
+      positions[start + i] = prefix + i;
+    }
+    if (tile == 0 && lane == 0) {
+      extend_start_loc[req] = static_cast<int32_t>(start);
+    }
+  }
+};
+
+}  // namespace
+
+void muse_compute_position_impl(
+    torch::Tensor positions,
+    torch::Tensor extend_start_loc,
+    torch::Tensor prefix_lens,
+    torch::Tensor seq_lens,
+    int64_t max_seq_len_hint) {
+  TORCH_CHECK(
+      positions.is_xpu() && positions.scalar_type() == at::kLong && positions.is_contiguous(),
+      "positions must be contiguous XPU int64");
+  TORCH_CHECK(
+      extend_start_loc.is_xpu() && extend_start_loc.scalar_type() == at::kInt && extend_start_loc.is_contiguous(),
+      "extend_start_loc must be contiguous XPU int32");
+  TORCH_CHECK(
+      prefix_lens.is_xpu() && (prefix_lens.scalar_type() == at::kInt || prefix_lens.scalar_type() == at::kLong) &&
+          prefix_lens.is_contiguous() && seq_lens.is_xpu() &&
+          (seq_lens.scalar_type() == at::kInt || seq_lens.scalar_type() == at::kLong) && seq_lens.is_contiguous(),
+      "lengths must be contiguous XPU int32 or int64");
+  const int64_t batch = seq_lens.numel();
+  TORCH_CHECK(
+      extend_start_loc.numel() == batch && (prefix_lens.numel() == 0 || prefix_lens.numel() == batch),
+      "lengths must match batch");
+  if (batch == 0) {
+    return;
+  }
+  auto queue = at::xpu::getCurrentXPUStream().queue();
+  const bool has_prefix = prefix_lens.numel() == batch;
+  // Spread long requests across workgroups; keep one group for short requests.
+  // The model already has a host length list. Its maximum avoids stranding a
+  // long request when the average length is diluted by empty/short requests.
+  // A stale or missing hint only changes occupancy: the kernel's strided loop
+  // still covers every sequence element.
+  const int64_t average_groups = (positions.numel() + batch * 512 - 1) / (batch * 512);
+  const int64_t hinted_groups = max_seq_len_hint > 0 ? (max_seq_len_hint + 511) / 512 : 1;
+  const int64_t groups_per_request = std::min<int64_t>(8, std::max<int64_t>({1, average_groups, hinted_groups}));
+  const auto global_size = sycl::range<1>(batch * groups_per_request * kPositionWorkgroup);
+  const auto local_size = sycl::range<1>(kPositionWorkgroup);
+  if (prefix_lens.scalar_type() == at::kInt && seq_lens.scalar_type() == at::kInt) {
+    MuseComputePositionKernel<int32_t, int32_t> kernel{
+        positions.data_ptr<int64_t>(),
+        extend_start_loc.data_ptr<int32_t>(),
+        prefix_lens.data_ptr<int32_t>(),
+        seq_lens.data_ptr<int32_t>(),
+        batch,
+        groups_per_request,
+        has_prefix};
+    sycl_kernel_submit(global_size, local_size, queue, kernel);
+  } else if (prefix_lens.scalar_type() == at::kLong && seq_lens.scalar_type() == at::kLong) {
+    MuseComputePositionKernel<int64_t, int64_t> kernel{
+        positions.data_ptr<int64_t>(),
+        extend_start_loc.data_ptr<int32_t>(),
+        prefix_lens.data_ptr<int64_t>(),
+        seq_lens.data_ptr<int64_t>(),
+        batch,
+        groups_per_request,
+        has_prefix};
+    sycl_kernel_submit(global_size, local_size, queue, kernel);
+  } else if (prefix_lens.scalar_type() == at::kInt) {
+    MuseComputePositionKernel<int32_t, int64_t> kernel{
+        positions.data_ptr<int64_t>(),
+        extend_start_loc.data_ptr<int32_t>(),
+        prefix_lens.data_ptr<int32_t>(),
+        seq_lens.data_ptr<int64_t>(),
+        batch,
+        groups_per_request,
+        has_prefix};
+    sycl_kernel_submit(global_size, local_size, queue, kernel);
+  } else {
+    MuseComputePositionKernel<int64_t, int32_t> kernel{
+        positions.data_ptr<int64_t>(),
+        extend_start_loc.data_ptr<int32_t>(),
+        prefix_lens.data_ptr<int64_t>(),
+        seq_lens.data_ptr<int32_t>(),
+        batch,
+        groups_per_request,
+        has_prefix};
+    sycl_kernel_submit(global_size, local_size, queue, kernel);
+  }
+}
+
+void muse_compute_position(
+    torch::Tensor positions, torch::Tensor extend_start_loc, torch::Tensor prefix_lens, torch::Tensor seq_lens) {
+  muse_compute_position_impl(positions, extend_start_loc, prefix_lens, seq_lens, -1);
+}
+
+void muse_compute_position_with_hint(
+    torch::Tensor positions,
+    torch::Tensor extend_start_loc,
+    torch::Tensor prefix_lens,
+    torch::Tensor seq_lens,
+    int64_t max_seq_len_hint) {
+  TORCH_CHECK(max_seq_len_hint >= 0, "max_seq_len_hint must be nonnegative");
+  muse_compute_position_impl(positions, extend_start_loc, prefix_lens, seq_lens, max_seq_len_hint);
+}
+
+}  // namespace at::native::xpu
diff --git a/artifacts/position/bench_framework_patch.py b/artifacts/position/bench_framework_patch.py
new file mode 100644
index 0000000000000000000000000000000000000000..0845d67b4f3dadac0931cbc6c0d6a35a73bd967b
--- /dev/null
+++ b/artifacts/position/bench_framework_patch.py
@@ -0,0 +1,168 @@
+"""Compare old and patched SGLang position wrappers with the AOT SYCL op."""
+
+import importlib
+import importlib.util
+import json
+import os
+import tempfile
+from pathlib import Path
+from statistics import median
+
+import torch
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def spread(samples):
+    values = sorted(samples)
+    return values[6], values[24]
+
+
+old = load_module("position_old_main", "/workspace/artifacts/position/main_position.py")
+patched = load_module(
+    "position_patched_main",
+    "/root/worktrees/sglang/muse-position-triton-split-main/python/sglang/kernels/ops/attention/position.py",
+)
+importlib.import_module("position_aot_after")
+assert torch.xpu.is_available()
+
+order = os.environ.get("POSITION_ORDER", "old-first")
+assert order in ("old-first", "patched-first")
+print(
+    json.dumps(
+        {
+            "meta": {
+                "order": order,
+                "device": torch.xpu.get_device_name(0),
+                "dtype": "int32 lengths and prefix, int64 positions, int32 starts",
+                "layout": "contiguous",
+                "timing": "torch.profiler XPU kernel event duration, microseconds",
+                "samples": 31,
+            }
+        }
+    ),
+    flush=True,
+)
+
+cases = [
+    ([1] * 8, 0),
+    ([512] * 8, 0),
+    ([1024] * 8, 0),
+    ([1536] * 8, 0),
+    ([1792] * 8, 0),
+    ([2048] * 8, 0),
+    ([4096] * 7, 0),
+    ([4096] * 8, 4096),
+    ([8193] * 8, 8193),
+    ([4096] + [0] * 7, 4096),
+    ([8193] + [0] * 7, 8193),
+    ([1, 4097, 33], 4097),
+    ([0, 17, 8193, 1], 8193),
+]
+
+for lengths, hint in cases:
+    batch, total = len(lengths), sum(lengths)
+    seq = torch.tensor(lengths, dtype=torch.int32, device="xpu")
+    prefix = torch.zeros(batch, dtype=torch.int32, device="xpu")
+    if batch == 3:
+        prefix = torch.tensor([2, 4, 6], dtype=torch.int32, device="xpu")
+    if batch == 4:
+        prefix = torch.empty(0, dtype=torch.int32, device="xpu")
+    positions_sycl = torch.empty(total, dtype=torch.int64, device="xpu")
+    starts_sycl = torch.empty(batch, dtype=torch.int32, device="xpu")
+
+    def old_call():
+        return old.compute_position_triton(prefix, seq, total)
+
+    def patched_call():
+        return patched.compute_position_triton(prefix, seq, total, hint)
+
+    def sycl_call():
+        if hint > 0:
+            torch.ops.sgl_kernel.muse_compute_position_with_hint(
+                positions_sycl, starts_sycl, prefix, seq, hint
+            )
+        else:
+            torch.ops.sgl_kernel.muse_compute_position(
+                positions_sycl, starts_sycl, prefix, seq
+            )
+        return positions_sycl, starts_sycl
+
+    expected = torch.cat(
+        [
+            torch.arange(size, dtype=torch.int64, device="xpu")
+            + (prefix[i] if prefix.numel() else 0)
+            for i, size in enumerate(lengths)
+        ]
+    )
+    expected_starts = torch.tensor(
+        [sum(lengths[:i]) for i in range(batch)], dtype=torch.int32, device="xpu"
+    )
+    for fn in (old_call, patched_call, sycl_call):
+        positions, starts = fn()
+        torch.xpu.synchronize()
+        torch.testing.assert_close(positions, expected, rtol=0, atol=0)
+        torch.testing.assert_close(starts, expected_starts, rtol=0, atol=0)
+    print(json.dumps({"accuracy": "PASS", "lengths": lengths, "hint": hint}), flush=True)
+
+    calls = (
+        (old_call, patched_call, sycl_call)
+        if order == "old-first"
+        else (patched_call, old_call, sycl_call)
+    )
+    for _ in range(5):
+        for fn in calls:
+            fn()
+    torch.xpu.synchronize()
+    with torch.profiler.profile(
+        activities=[torch.profiler.ProfilerActivity.CPU, torch.profiler.ProfilerActivity.XPU]
+    ) as profile:
+        for _ in range(31):
+            for fn in calls:
+                fn()
+        torch.xpu.synchronize()
+    with tempfile.TemporaryDirectory() as directory:
+        path = Path(directory) / "trace.json"
+        profile.export_chrome_trace(str(path))
+        events = json.loads(path.read_text())["traceEvents"]
+    kernels = [
+        (float(event["ts"]), event["name"], float(event["dur"]))
+        for event in events
+        if event.get("cat") == "kernel"
+        and (
+            "compute_position_kernel" in event.get("name", "")
+            or "MuseComputePositionKernel" in event.get("name", "")
+        )
+    ]
+    kernels.sort()
+    assert len(kernels) == 93, (lengths, len(kernels), kernels[:6])
+    raw = {"old": [], "patched": [], "sycl": []}
+    names = (
+        ("old", "patched", "sycl")
+        if order == "old-first"
+        else ("patched", "old", "sycl")
+    )
+    for start in range(0, len(kernels), 3):
+        group = kernels[start : start + 3]
+        assert all("compute_position_kernel" in group[i][1] for i in (0, 1))
+        assert "MuseComputePositionKernel" in group[2][1]
+        for i, name in enumerate(names):
+            raw[name].append(group[i][2])
+    print(
+        json.dumps(
+            {
+                "lengths": lengths,
+                "hint": hint,
+                "raw_us": raw,
+                "p50_us": {name: median(values) for name, values in raw.items()},
+                "p20_p80_us": {name: spread(values) for name, values in raw.items()},
+            }
+        ),
+        flush=True,
+    )
+    torch.xpu.synchronize()
